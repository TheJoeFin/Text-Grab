<Window
    x:Class="Text_Grab.Controls.TrayFlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Text Grab"
    AutomationProperties.AutomationId="TrayFlyoutWindow"
    Width="340"
    Height="500"
    AllowsTransparency="False"
    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
    Deactivated="Window_Deactivated"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="Window_Loaded"
    PreviewKeyDown="Window_PreviewKeyDown"
    PreviewTextInput="Window_PreviewTextInput"
    ResizeMode="NoResize"
    ShowActivated="True"
    ShowInTaskbar="False"
    Topmost="True"
    WindowStartupLocation="Manual"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <SolidColorBrush x:Key="FlyoutHoverBrush" Color="#1E595F" />
        <SolidColorBrush x:Key="FlyoutPressedBrush" Color="#071818" />
        <SolidColorBrush x:Key="FlyoutFocusRingBrush" Color="#3CB1BE" />

        <!--  Shared template for the launch buttons: flat, rounded, teal on hover, ring on keyboard focus.  -->
        <ControlTemplate x:Key="FlyoutButtonTemplate" TargetType="Button">
            <Border
                x:Name="border"
                Background="{TemplateBinding Background}"
                BorderBrush="Transparent"
                BorderThickness="1.5"
                CornerRadius="4"
                SnapsToDevicePixels="True">
                <ContentPresenter
                    x:Name="presenter"
                    Margin="{TemplateBinding Padding}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Focusable="False" />
            </Border>
            <ControlTemplate.Triggers>
                <!--  The hover/pressed fills are dark teal in every theme, so the content turns white on them.  -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="border" Property="Background" Value="{StaticResource FlyoutHoverBrush}" />
                    <Setter TargetName="presenter" Property="TextElement.Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter TargetName="border" Property="BorderBrush" Value="{StaticResource FlyoutFocusRingBrush}" />
                    <Setter TargetName="border" Property="Background" Value="{StaticResource FlyoutHoverBrush}" />
                    <Setter TargetName="presenter" Property="TextElement.Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="border" Property="Background" Value="{StaticResource FlyoutPressedBrush}" />
                    <Setter TargetName="presenter" Property="TextElement.Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="border" Property="Opacity" Value="0.35" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!--  Bottom row: launch a mode.  -->
        <Style x:Key="FlyoutTealButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource DarkTeal}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="2,8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template" Value="{StaticResource FlyoutButtonTemplate}" />
            <EventSetter Event="Click" Handler="ActionButton_Click" />
        </Style>

        <!--  Top row: open the last item. Quieter than the launch row.  -->
        <Style
            x:Key="FlyoutNeutralButton"
            BasedOn="{StaticResource FlyoutTealButton}"
            TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="FlyoutListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="AutomationProperties.AutomationId" Value="TrayFlyout.Item" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <Grid>
                                <Rectangle
                                    x:Name="AccentBar"
                                    Width="3"
                                    Height="18"
                                    Margin="1,0,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Fill="{StaticResource Teal}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Visibility="Collapsed" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#661E595F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource DarkTeal}" />
                                <Setter TargetName="AccentBar" Property="Visibility" Value="Visible" />
                                <!--  Selected rows are dark teal in every theme, so their text must be light.  -->
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsKeyboardFocusWithin" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource FlyoutHoverBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="FlyoutItemTemplate">
            <Grid AutomationProperties.Name="{Binding AutomationName}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon
                    Margin="4,0,12,0"
                    VerticalAlignment="Center"
                    FontSize="18"
                    Foreground="{StaticResource Teal}"
                    Symbol="{Binding Symbol}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!--  Both lines inherit the row's Foreground (white when selected); the subtitle is just dimmed.  -->
                    <TextBlock
                        FontSize="13"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Opacity="0.72"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Border
        BorderBrush="{StaticResource Teal}"
        BorderThickness="1"
        CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Header  -->
            <Grid Margin="12,8,6,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:ImageIcon
                    Width="20"
                    Height="20"
                    VerticalAlignment="Center"
                    Source="/Text-Grab;component/Images/TealSelect40.png" />
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="13"
                    Text="Text Grab" />
                <Button
                    x:Name="SettingsButton"
                    Grid.Column="2"
                    Padding="6"
                    AutomationProperties.AutomationId="TrayFlyout.Settings"
                    AutomationProperties.Name="Settings"
                    Click="SettingsButton_Click"
                    Focusable="False"
                    Style="{StaticResource SymbolButton}"
                    ToolTip="Settings">
                    <ui:SymbolIcon FontSize="16" Symbol="Settings24" />
                </Button>
            </Grid>

            <!--  Search: same look as the shared SearchBar, without the regex controls  -->
            <Border
                x:Name="SearchBorder"
                Grid.Row="1"
                MinHeight="32"
                Margin="10,4,10,8"
                Background="{DynamicResource SolidBackgroundFillColorBaseAltBrush}"
                BorderThickness="1"
                CornerRadius="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource TextBox.Static.Border}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{StaticResource Teal}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon
                        Margin="9,0,2,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Symbol="Search24" />
                    <Grid Grid.Column="1">
                        <TextBox
                            x:Name="SearchBox"
                            Padding="4,0"
                            VerticalContentAlignment="Center"
                            AutomationProperties.AutomationId="TrayFlyout.Search"
                            AutomationProperties.Name="Search recent items"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="{DynamicResource TextFillColorPrimaryBrush}"
                            FontFamily="Segoe UI"
                            Style="{StaticResource TextBoxStyle1}"
                            TextChanged="SearchBox_TextChanged" />
                        <TextBlock
                            x:Name="SearchPlaceholder"
                            Margin="8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            IsHitTestVisible="False"
                            Opacity="0.5"
                            Text="Search recent items" />
                    </Grid>
                    <Button
                        x:Name="ClearSearchButton"
                        Grid.Column="2"
                        Margin="0,0,4,0"
                        Padding="6,4"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Clear search"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="ClearSearchButton_Click"
                        Focusable="False"
                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        Style="{StaticResource SymbolButton}"
                        ToolTip="Clear search"
                        Visibility="Collapsed">
                        <ui:SymbolIcon FontSize="14" Symbol="Dismiss24" />
                    </Button>
                    <!--  Accent underline while the field has focus  -->
                    <Border
                        Grid.ColumnSpan="3"
                        Height="2"
                        VerticalAlignment="Bottom"
                        Background="{StaticResource Teal}"
                        CornerRadius="0,0,4,4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=SearchBorder}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                    </Border>
                </Grid>
            </Border>

            <!--  Recent items  -->
            <Border Grid.Row="2" Background="{DynamicResource SolidBackgroundFillColorTertiaryBrush}">
                <Grid>
                    <ListBox
                        x:Name="ItemsList"
                        Padding="0,4"
                        AutomationProperties.AutomationId="TrayFlyout.Items"
                        AutomationProperties.Name="Recent items"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemContainerStyle="{StaticResource FlyoutListItemStyle}"
                        ItemTemplate="{StaticResource FlyoutItemTemplate}"
                        KeyboardNavigation.TabNavigation="Once"
                        PreviewMouseLeftButtonUp="ItemsList_PreviewMouseLeftButtonUp"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionMode="Single" />
                    <TextBlock
                        x:Name="EmptyText"
                        Margin="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="TrayFlyout.EmptyText"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Nothing here yet"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!--  Top row: open last. Bottom row: launch a mode. Column N of both rows are related.  -->
            <UniformGrid
                x:Name="ButtonGrid"
                Grid.Row="3"
                Margin="8"
                Columns="4"
                Rows="2">
                <Button
                    x:Name="PreviousRegionButton"
                    AutomationProperties.AutomationId="TrayFlyout.PreviousRegion"
                    AutomationProperties.Name="Grab previous region"
                    Style="{StaticResource FlyoutNeutralButton}"
                    Tag="PreviousRegion"
                    ToolTip="Grab previous region">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="20" Symbol="History24" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Text="Last region"
                            TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="LastGrabFrameButton"
                    AutomationProperties.AutomationId="TrayFlyout.LastGrabFrame"
                    AutomationProperties.Name="Open last Grab Frame"
                    Style="{StaticResource FlyoutNeutralButton}"
                    Tag="LastGrabFrame"
                    ToolTip="Open last Grab Frame">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="20" Symbol="ImageEdit24" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Text="Last frame"
                            TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="LastEditTextButton"
                    AutomationProperties.AutomationId="TrayFlyout.LastEditText"
                    AutomationProperties.Name="Open last Edit Text window"
                    Style="{StaticResource FlyoutNeutralButton}"
                    Tag="LastEditText"
                    ToolTip="Open last Edit Text window">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="20" Symbol="History20" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Text="Last text"
                            TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ClipboardButton"
                    AutomationProperties.AutomationId="TrayFlyout.Clipboard"
                    AutomationProperties.Name="Open clipboard content"
                    Style="{StaticResource FlyoutNeutralButton}"
                    Tag="Clipboard"
                    ToolTip="Open clipboard content">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="20" Symbol="ClipboardPaste24" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Text="Clipboard"
                            TextAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="FullscreenButton"
                    AutomationProperties.AutomationId="TrayFlyout.Fullscreen"
                    AutomationProperties.Name="Fullscreen grab"
                    Style="{StaticResource FlyoutTealButton}"
                    Tag="Fullscreen"
                    ToolTip="Fullscreen grab">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="20" Symbol="SlideAdd24" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Text="Fullscreen"
                            TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="GrabFrameButton"
                    AutomationProperties.AutomationId="TrayFlyout.GrabFrame"
                    AutomationProperties.Name="Grab Frame"
                    Style="{StaticResource FlyoutTealButton}"
                    Tag="GrabFrame"
                    ToolTip="Grab Frame">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="20" Symbol="PanelBottom20" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Text="Grab Frame"
                            TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="EditTextButton"
                    AutomationProperties.AutomationId="TrayFlyout.EditText"
                    AutomationProperties.Name="Edit Text window"
                    Style="{StaticResource FlyoutTealButton}"
                    Tag="EditText"
                    ToolTip="Edit Text window">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="20" Symbol="WindowEdit20" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Text="Edit Text"
                            TextAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="LookupButton"
                    AutomationProperties.AutomationId="TrayFlyout.Lookup"
                    AutomationProperties.Name="Quick Simple Lookup"
                    Style="{StaticResource FlyoutTealButton}"
                    Tag="Lookup"
                    ToolTip="Quick Simple Lookup">
                    <StackPanel>
                        <ui:SymbolIcon FontSize="20" Symbol="TextBulletListSquareSearch20" />
                        <TextBlock
                            Margin="0,4,0,0"
                            FontSize="11"
                            Text="Lookup"
                            TextAlignment="Center" />
                    </StackPanel>
                </Button>
            </UniformGrid>
        </Grid>
    </Border>
</Window>

<ui:FluentWindow
    x:Class="Text_Grab.Controls.GrabPageRangeDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Grab Multiple Pages"
    AutomationProperties.AutomationId="GrabPageRangeDialog"
    Width="420"
    MinWidth="360"
    ResizeMode="NoResize"
    SizeToContent="Height"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.Resources>
        <ui:ImageIcon x:Key="TextGrabIcon" Source="/Text-Grab;component/Images/TealSelect40.png" />
    </Window.Resources>

    <Grid Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Grab Multiple Pages"
            Height="32"
            Margin="2,2,2,0"
            Padding="8,2"
            Icon="{StaticResource TextGrabIcon}" />

        <StackPanel Grid.Row="1" Margin="12">
            <TextBlock
                x:Name="DescriptionTextBlock"
                Margin="0,0,0,12"
                TextWrapping="Wrap" />

            <TextBlock Margin="0,0,0,4" Text="Pages to grab:" />
            <RadioButton
                x:Name="AllPagesRadioButton"
                AutomationProperties.AutomationId="GrabPageRange.AllPages"
                Checked="PageScopeRadioButton_Checked"
                Content="All pages"
                GroupName="PageScope" />
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <RadioButton
                    x:Name="RangeRadioButton"
                    AutomationProperties.AutomationId="GrabPageRange.Range"
                    Checked="PageScopeRadioButton_Checked"
                    Content="Range"
                    GroupName="PageScope"
                    IsChecked="True" />
                <ui:TextBox
                    x:Name="PagesTextBox"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="GrabPageRange.Pages"
                    GotKeyboardFocus="PagesTextBox_GotKeyboardFocus"
                    PlaceholderText="e.g. 4-9,12"
                    TextChanged="PagesTextBox_TextChanged" />
            </Grid>
            <TextBlock
                x:Name="PagesHintTextBlock"
                Margin="0,0,0,12"
                FontSize="11"
                Opacity="0.7"
                Text="Separate pages with commas and use dashes for ranges, like 4-9,12. Use 5- for page 5 to the end."
                TextWrapping="Wrap" />

            <TextBlock Margin="0,0,0,4" Text="Of those pages, grab:" />
            <StackPanel
                x:Name="PageParityPanel"
                AutomationProperties.AutomationId="GrabPageRange.PageParityOptions"
                Margin="0,0,0,12"
                Orientation="Horizontal">
                <RadioButton
                    Content="Every page"
                    GroupName="PageParity"
                    IsChecked="True"
                    Tag="all" />
                <RadioButton
                    Margin="12,0,0,0"
                    Content="Odd only"
                    GroupName="PageParity"
                    Tag="odd" />
                <RadioButton
                    Margin="12,0,0,0"
                    Content="Even only"
                    GroupName="PageParity"
                    Tag="even" />
            </StackPanel>

            <CheckBox
                x:Name="BlankLineBetweenPagesCheckBox"
                AutomationProperties.AutomationId="GrabPageRange.BlankLineBetweenPages"
                Content="Insert a blank line between pages" />

            <TextBlock
                x:Name="RangeErrorText"
                AutomationProperties.AutomationId="GrabPageRange.Error"
                Margin="0,8,0,0"
                FontSize="11"
                Foreground="Red"
                TextWrapping="Wrap"
                MinHeight="30"
                Text=""
                Visibility="Hidden" />
        </StackPanel>

        <StackPanel
            Grid.Row="2"
            Margin="12,0,12,12"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="OkButton"
                AutomationProperties.AutomationId="GrabPageRange.OkButton"
                Margin="0,0,6,0"
                Appearance="Primary"
                Click="OkButton_Click"
                Content="Grab" />
            <ui:Button
                AutomationProperties.AutomationId="GrabPageRange.CancelButton"
                Click="CancelButton_Click"
                Content="Cancel" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>

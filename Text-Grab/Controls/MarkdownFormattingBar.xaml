<UserControl
    x:Class="Text_Grab.Controls.MarkdownFormattingBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    AutomationProperties.Name="Markdown formatting">
    <UserControl.Resources>
        <Style x:Key="FormattingButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Surface"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Surface" Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorDisabledBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TableSizeCellStyle" TargetType="Button">
            <Setter Property="Width" Value="23" />
            <Setter Property="Height" Value="23" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border
        Padding="6,3"
        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
        BorderThickness="0,1,0,0">
        <WrapPanel HorizontalAlignment="Center">
            <Button
                x:Name="HeadingButton"
                Padding="8,0"
                AutomationProperties.AutomationId="EditText.Markdown.Heading"
                AutomationProperties.Name="Heading"
                Click="HeadingButton_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Change heading level">
                <Button.ContextMenu>
                    <ContextMenu Placement="Bottom">
                        <MenuItem Click="Heading_Click" Header="Normal text" Tag="0" />
                        <Separator />
                        <MenuItem Click="Heading_Click" Header="Heading 1" Tag="1" />
                        <MenuItem Click="Heading_Click" Header="Heading 2" Tag="2" />
                        <MenuItem Click="Heading_Click" Header="Heading 3" Tag="3" />
                        <MenuItem Click="Heading_Click" Header="Heading 4" Tag="4" />
                        <MenuItem Click="Heading_Click" Header="Heading 5" Tag="5" />
                        <MenuItem Click="Heading_Click" Header="Heading 6" Tag="6" />
                    </ContextMenu>
                </Button.ContextMenu>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Heading" />
                    <ui:SymbolIcon Margin="6,0,0,0" FontSize="10" Symbol="ChevronDown12" />
                </StackPanel>
            </Button>
            <Button
                x:Name="BoldButton"
                AutomationProperties.AutomationId="EditText.Markdown.Bold"
                AutomationProperties.Name="Bold"
                Click="Format_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Bold">
                <ui:SymbolIcon FontSize="16" Symbol="TextBold20" />
            </Button>
            <Button
                x:Name="ItalicButton"
                AutomationProperties.AutomationId="EditText.Markdown.Italic"
                AutomationProperties.Name="Italic"
                Click="Format_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Italic">
                <ui:SymbolIcon FontSize="16" Symbol="TextItalic20" />
            </Button>
            <Button
                x:Name="StrikethroughButton"
                AutomationProperties.AutomationId="EditText.Markdown.Strikethrough"
                AutomationProperties.Name="Strikethrough"
                Click="Format_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Strikethrough selected text"
                ToolTipService.ShowOnDisabled="True">
                <ui:SymbolIcon FontSize="16" Symbol="TextStrikethrough20" />
            </Button>
            <Button
                x:Name="SuperscriptButton"
                AutomationProperties.AutomationId="EditText.Markdown.Superscript"
                AutomationProperties.Name="Superscript"
                Click="Format_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Superscript selected text"
                ToolTipService.ShowOnDisabled="True">
                <ui:SymbolIcon FontSize="16" Symbol="TextSuperscript20" />
            </Button>
            <Button
                x:Name="SubscriptButton"
                AutomationProperties.AutomationId="EditText.Markdown.Subscript"
                AutomationProperties.Name="Subscript"
                Click="Format_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Subscript selected text"
                ToolTipService.ShowOnDisabled="True">
                <ui:SymbolIcon FontSize="16" Symbol="TextSubscript20" />
            </Button>
            <Button
                x:Name="BulletsButton"
                AutomationProperties.AutomationId="EditText.Markdown.Bullets"
                AutomationProperties.Name="Bulleted list"
                Click="Format_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Bulleted list">
                <ui:SymbolIcon FontSize="16" Symbol="TextBulletListLtr20" />
            </Button>
            <Button
                x:Name="NumberingButton"
                AutomationProperties.AutomationId="EditText.Markdown.Numbering"
                AutomationProperties.Name="Numbered list"
                Click="Format_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Numbered list">
                <ui:SymbolIcon FontSize="16" Symbol="TextNumberListLtr20" />
            </Button>
            <Button
                x:Name="QuoteButton"
                AutomationProperties.AutomationId="EditText.Markdown.Quote"
                AutomationProperties.Name="Block quote"
                Click="Format_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Block quote">
                <ui:SymbolIcon FontSize="16" Symbol="TextQuote20" />
            </Button>
            <Button
                x:Name="CodeBlockButton"
                AutomationProperties.AutomationId="EditText.Markdown.CodeBlock"
                AutomationProperties.Name="Code block"
                Click="Format_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Code block">
                <ui:SymbolIcon FontSize="16" Symbol="CodeBlock20" />
            </Button>
            <Button
                x:Name="TableButton"
                Padding="6,0"
                AutomationProperties.AutomationId="EditText.Markdown.Table"
                AutomationProperties.Name="Insert table"
                Click="TableButton_Click"
                Style="{StaticResource FormattingButtonStyle}"
                ToolTip="Insert table">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon FontSize="16" Symbol="Table24" />
                    <ui:SymbolIcon Margin="4,0,0,0" FontSize="10" Symbol="ChevronDown12" />
                </StackPanel>
            </Button>
            <Popup
                x:Name="TablePicker"
                AllowsTransparency="True"
                Opened="TablePicker_Opened"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=TableButton}"
                StaysOpen="False">
                <Border
                    Padding="8"
                    AutomationProperties.Name="Choose table size"
                    Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    PreviewKeyDown="TablePicker_PreviewKeyDown">
                    <StackPanel KeyboardNavigation.TabNavigation="Cycle">
                        <TextBlock x:Name="TableSizeLabel" Margin="1,0,0,5" FontWeight="SemiBold" />
                        <UniformGrid x:Name="TableSizeGrid" />
                        <TextBlock
                            Margin="1,5,0,0"
                            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                            Text="First row is the header" />
                    </StackPanel>
                </Border>
            </Popup>
        </WrapPanel>
    </Border>
</UserControl>

<UserControl
    x:Class="Text_Grab.Controls.ExternalLinkConfirmationContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Width="420"
    AutomationProperties.AutomationId="ExternalLink.ConfirmationContent"
    PreviewKeyDown="Content_PreviewKeyDown"
    Unloaded="Content_Unloaded">
    <StackPanel>
        <TextBlock
            x:Name="ActionDescription"
            Margin="0,0,0,12"
            TextWrapping="Wrap" />
        <TextBlock Margin="0,0,0,4" Text="Link details:" />
        <TextBox
            x:Name="TargetTextBox"
            MaxHeight="160"
            AutomationProperties.AutomationId="ExternalLink.Target"
            AutomationProperties.Name="Complete link details"
            IsReadOnly="True"
            TextWrapping="Wrap"
            VerticalScrollBarVisibility="Auto" />
        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
            <Button
                x:Name="WarningButton"
                Width="32"
                Height="32"
                Padding="4"
                AutomationProperties.AutomationId="ExternalLink.WarningButton"
                AutomationProperties.HelpText="Only open email and telephone links when you trust the source. These links open another app and may prepare a message or start a call."
                AutomationProperties.Name="Link safety warning"
                Background="Transparent"
                BorderThickness="0"
                Click="WarningButton_Click"
                ToolTip="Only open links when you trust the source.">
                <ui:SymbolIcon
                    FontSize="22"
                    Foreground="{DynamicResource SystemFillColorCautionBrush}"
                    Symbol="Warning24" />
            </Button>
            <TextBlock
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Text="Only continue if you trust the source." />
            <Popup
                x:Name="WarningPopup"
                AllowsTransparency="True"
                Placement="Bottom"
                PlacementTarget="{Binding ElementName=WarningButton}"
                StaysOpen="False">
                <Border
                    Padding="12"
                    Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <TextBlock
                        Width="340"
                        AutomationProperties.AutomationId="ExternalLink.WarningText"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Text="Only open this link when you trust the source of the text or image. Links from OCR, the clipboard, or a document may be supplied by someone else. Check the complete link before continuing: email links can prefill a message, and telephone links may start a call, incur charges, or reveal your number."
                        TextWrapping="Wrap" />
                </Border>
            </Popup>
        </StackPanel>
        <CheckBox
            x:Name="DontWarnAgainCheckBox"
            Margin="0,12,0,0"
            AutomationProperties.AutomationId="ExternalLink.DontWarnAgain"
            AutomationProperties.HelpText="You can turn this warning back on in Settings, Dangerous Options, External links." />
    </StackPanel>
</UserControl>

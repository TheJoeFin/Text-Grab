<ui:FluentWindow
    x:Class="Text_Grab.Controls.FindAndReplaceWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Find and Replace"
    AutomationProperties.AutomationId="FindReplaceDialog"
    Width="520"
    Height="560"
    MinWidth="400"
    MinHeight="300"
    Closed="Window_Closed"
    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    KeyUp="Window_KeyUp"
    Loaded="FindAndReplacedLoaded"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Window.CommandBindings>
        <CommandBinding
            CanExecute="TextSearch_CanExecute"
            Command="{x:Static local:FindAndReplaceWindow.TextSearchCmd}"
            Executed="TextSearch_Executed" />
        <CommandBinding
            CanExecute="Replace_CanExecute"
            Command="{x:Static local:FindAndReplaceWindow.ReplaceOneCmd}"
            Executed="Replace_Executed" />
        <CommandBinding
            CanExecute="Replace_CanExecute"
            Command="{x:Static local:FindAndReplaceWindow.ReplaceAllCmd}"
            Executed="ReplaceAll_Executed" />
        <CommandBinding
            CanExecute="ExtractPattern_CanExecute"
            Command="{x:Static local:FindAndReplaceWindow.ExtractPatternCmd}"
            Executed="ExtractPattern_Executed" />
        <CommandBinding
            CanExecute="DeleteAll_CanExecute"
            Command="{x:Static local:FindAndReplaceWindow.DeleteAllCmd}"
            Executed="DeleteAll_Executed" />
        <CommandBinding
            CanExecute="CopyMatchesCmd_CanExecute"
            Command="{x:Static local:FindAndReplaceWindow.CopyMatchesCmd}"
            Executed="CopyMatchesCmd_Executed" />
    </Window.CommandBindings>
    <Window.Resources>
        <ui:ImageIcon x:Key="TextGrabIcon" Source="/Text-Grab;component/Images/TealSelect40.png" />
    </Window.Resources>
    <Grid Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Find and Replace"
            Height="32"
            Margin="2,2,2,0"
            Padding="8,2"
            Icon="{StaticResource TextGrabIcon}" />

        <Grid x:Name="MainContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <ToggleButton
                x:Name="MoreOptionsToggleButton"
                AutomationProperties.AutomationId="FindReplace.MoreOptionsToggle"
                Width="32"
                Margin="6,6,0,0"
                Background="Transparent"
                BorderBrush="Transparent"
                Click="MoreOptionsToggleButton_Click"
                Content="▼"
                IsChecked="True"
                RenderTransformOrigin="0.5,0.5"
                Style="{DynamicResource ToggleSymbolButton}"
                ToolTip="Show or hide more options">
                <ToggleButton.RenderTransform>
                    <RotateTransform Angle="0" />
                </ToggleButton.RenderTransform>
                <ToggleButton.Triggers>
                    <EventTrigger RoutedEvent="ToggleButton.Checked">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.Angle"
                                    To="0"
                                    Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="ToggleButton.Unchecked">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetProperty="RenderTransform.Angle"
                                    To="-90"
                                    Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ToggleButton.Triggers>
            </ToggleButton>

            <local:SearchBar
                x:Name="SearchBar"
                AutomationProperties.AutomationId="FindReplace.Search"
                Grid.Column="1"
                Margin="6,6,6,0"
                VerticalAlignment="Center"
                AcceptsReturn="True"
                AcceptsTab="True"
                ExactMatchChanged="OptionsChangedRefresh"
                KeyUp="FindTextBox_KeyUp"
                PlaceholderText="Find..."
                SearchChanged="SearchBar_SearchChanged"
                ShowExactMatchToggle="True" />
            <local:CollapsibleButton
                x:Name="FindButton"
                AutomationProperties.AutomationId="FindReplace.FindButton"
                Grid.Row="0"
                Grid.Column="2"
                Width="130"
                Margin="0,6,6,0"
                Padding="4"
                ButtonSymbol="Search24"
                ButtonText="Find"
                Command="{x:Static local:FindAndReplaceWindow.TextSearchCmd}" />

            <TextBox
                x:Name="ReplaceTextBox"
                AutomationProperties.AutomationId="FindReplace.ReplaceText"
                Grid.Row="1"
                Grid.Column="1"
                Margin="6,6,6,0"
                VerticalContentAlignment="Center"
                AcceptsReturn="True"
                AcceptsTab="True"
                FontFamily="Segoe UI"
                Visibility="Visible" />
            <local:CollapsibleButton
                x:Name="ReplaceButton"
                AutomationProperties.AutomationId="FindReplace.ReplaceButton"
                Grid.Row="1"
                Grid.Column="2"
                Width="130"
                Margin="0,6,6,0"
                Padding="4"
                ButtonSymbol="ArrowRepeat124"
                ButtonText="Replace"
                Command="{x:Static local:FindAndReplaceWindow.ReplaceOneCmd}"
                Visibility="Visible" />

            <Grid
                x:Name="BulkActionsGrid"
                Grid.Row="2"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="6,6,6,0"
                d:Visibility="Visible"
                Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <local:CollapsibleButton
                    x:Name="DeleteAllMatches"
                    AutomationProperties.AutomationId="FindReplace.DeleteAllButton"
                    Grid.Column="0"
                    Margin="0,0,3,0"
                    VerticalAlignment="Center"
                    Background="Red"
                    ButtonSymbol="DeleteLines20"
                    ButtonText="Delete All"
                    Command="{x:Static local:FindAndReplaceWindow.DeleteAllCmd}" />

                <local:CollapsibleButton
                    x:Name="ReplaceAllButton"
                    AutomationProperties.AutomationId="FindReplace.ReplaceAllButton"
                    Grid.Column="1"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    ButtonSymbol="ArrowRepeatAll24"
                    ButtonText="Replace All"
                    Command="{x:Static local:FindAndReplaceWindow.ReplaceAllCmd}" />
            </Grid>
            <Grid
                x:Name="MatchActionsGrid"
                Grid.Row="3"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="6,6,6,0"
                d:Visibility="Visible"
                Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <local:CollapsibleButton
                    x:Name="MatchesToEditWindow"
                    Grid.Column="0"
                    Margin="0,0,3,0"
                    VerticalAlignment="Center"
                    ButtonSymbol="WindowEdit20"
                    ButtonText="Edit Matches"
                    Command="{x:Static local:FindAndReplaceWindow.CopyMatchesCmd}" />

                <local:CollapsibleButton
                    x:Name="ApplyTemplateButton"
                    Grid.Column="1"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    ButtonSymbol="DocumentTableSearch24"
                    ButtonText="Apply Template"
                    Click="ApplyTemplateButton_Click"
                    ToolTip="Apply a text-only Grab Template to each match" />
            </Grid>
            <Grid
                x:Name="PatternActionsGrid"
                Grid.Row="4"
                Grid.Column="1"
                Grid.ColumnSpan="2"
                Margin="6,6,6,0"
                Visibility="Visible">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <local:CollapsibleButton
                    x:Name="ManageRegexButton"
                    Grid.Column="0"
                    Margin="0,0,3,0"
                    VerticalAlignment="Center"
                    ButtonSymbol="Book24"
                    ButtonText="Manage Patterns"
                    Click="ManageRegexButton_Click" />

                <local:CollapsibleButton
                    x:Name="ExtractSimplePattern"
                    Grid.Column="1"
                    Margin="3,0,0,0"
                    VerticalAlignment="Center"
                    ButtonSymbol="LightbulbFilament24"
                    ButtonText="Extract Regex"
                    Command="{x:Static local:FindAndReplaceWindow.ExtractPatternCmd}" />

                <StackPanel
                    Grid.Row="1"
                    Grid.ColumnSpan="2"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal">
                    <ui:Button
                        x:Name="SavePatternButton"
                        Width="32"
                        Height="30"
                        Margin="0,6,6,0"
                        Padding="4"
                        Click="SavePatternButton_Click"
                        Icon="{ui:SymbolIcon Save24}"
                        ToolTip="Save pattern to Patterns Manager"
                        Visibility="Collapsed" />
                    <StackPanel
                        x:Name="PrecisionSliderPanel"
                        Margin="0,6,0,0"
                        Orientation="Horizontal"
                        Visibility="Collapsed">
                        <TextBlock
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource TextBodyNormal}"
                            Text="Precision" />
                        <Slider
                            x:Name="PrecisionSlider"
                            Width="160"
                            VerticalAlignment="Center"
                            IsSnapToTickEnabled="True"
                            Maximum="5"
                            Minimum="0"
                            TickFrequency="1"
                            TickPlacement="BottomRight"
                            ToolTip="Adjust regex pattern precision (0=least precise, 5=most precise)"
                            ValueChanged="PrecisionSlider_ValueChanged"
                            Value="3" />
                    </StackPanel>
                </StackPanel>
            </Grid>

        </Grid>

        <TextBlock
            x:Name="MatchesText"
            Grid.Row="2"
            Margin="6"
            FontSize="18"
            Foreground="{StaticResource Teal}"
            Text="Matches" />

        <Border Grid.Row="3" Background="{ui:ThemeResource SolidBackgroundFillColorBaseAltBrush}">
            <ui:ListView
                x:Name="ResultsListView"
                AutomationProperties.AutomationId="FindReplace.Results"
                Grid.Row="2"
                Background="Transparent"
                Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                ScrollViewer.CanContentScroll="True"
                ScrollViewer.VerticalScrollBarVisibility="Auto"
                SelectionChanged="ResultsListView_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="100" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Margin="0,0,8,0"
                                Text="{Binding Count}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Text="{Binding LocationDisplay}" />
                            <TextBlock
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                Foreground="Gray"
                                Text="{Binding PreviewLeft}" />
                            <TextBlock
                                Grid.Column="3"
                                FontWeight="Bold"
                                Text="{Binding Text}" />
                            <TextBlock
                                Grid.Column="4"
                                HorizontalAlignment="Left"
                                Foreground="Gray"
                                Text="{Binding PreviewRight}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ui:ListView>
        </Border>

        <ui:ProgressRing
            x:Name="LoadingSpinner"
            AutomationProperties.AutomationId="FindReplace.Loading"
            Grid.Row="3"
            IsIndeterminate="True"
            Visibility="Collapsed" />
    </Grid>
</ui:FluentWindow>

<UserControl
    x:Class="Text_Grab.Controls.ShortcutControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="ShortcutUserControl"
    Margin="0,0,0,3"
    HorizontalAlignment="Stretch"
    d:DataContext="{d:DesignInstance Type=local:ShortcutControl}"
    d:DesignHeight="60"
    d:DesignWidth="500"
    BorderThickness="3"
    PreviewKeyDown="ShortcutControl_PreviewKeyDown"
    PreviewKeyUp="ShortcutControl_PreviewKeyUp"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BitmapImage x:Key="WinSymIcon" UriSource="/Text-Grab;component/Images/WinSym.png" />
    </UserControl.Resources>
    <Border
        Padding="14,10"
        HorizontalAlignment="Stretch"
        Background="{ui:ThemeResource CardBackgroundFillColorDefaultBrush}"
        BorderBrush="{ui:ThemeResource CardStrokeColorDefaultBrush}"
        BorderThickness="1"
        CornerRadius="4">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:ToggleSwitch
                x:Name="IsEnabledToggleSwitch"
                VerticalAlignment="Center"
                Click="IsEnabledToggleSwitch_Click"
                IsChecked="{Binding Path=IsShortcutEnabled, ElementName=ShortcutUserControl, Mode=TwoWay}">
                <TextBlock
                    x:Name="ShortcutNameBlock"
                    Margin="8,0,20,0"
                    d:Text="ShortcutName"
                    Style="{StaticResource TextBodyNormal}"
                    Text="{Binding ElementName=ShortcutUserControl, Path=ShortcutName, Mode=TwoWay}" />
            </ui:ToggleSwitch>
            <StackPanel
                x:Name="ButtonsPanel"
                Grid.Column="1"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <ToggleButton x:Name="RecordingToggleButton" Click="RecordingToggleButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Record24" />
                        <TextBlock
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Text="Record" />
                    </StackPanel>
                </ToggleButton>
                <Border
                    x:Name="WinKey"
                    Width="24"
                    Height="24"
                    Margin="4,0"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="5">
                    <Image
                        x:Name="WinSymImage"
                        Width="10"
                        Height="10"
                        Source="{StaticResource WinSymIcon}"
                        Stretch="Uniform" />
                </Border>
                <Border
                    x:Name="CtrlKey"
                    Width="46"
                    Height="24"
                    Margin="4,0"
                    Padding="6,0,0,1"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="5">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="Black"
                        Text="Ctrl" />
                </Border>
                <Border
                    x:Name="ShiftKey"
                    Width="70"
                    Height="24"
                    Margin="4,0"
                    Padding="6,0,0,1"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="5">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="Black"
                        Text="Shift" />
                </Border>
                <Border
                    x:Name="AltKey"
                    Width="46"
                    Height="24"
                    Margin="4,0"
                    Padding="6,0,0,1"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="5">
                    <TextBlock
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="Black"
                        Text="Alt" />
                </Border>
                <Border
                    x:Name="KeyKey"
                    Height="24"
                    MinWidth="24"
                    Margin="4,0"
                    Padding="4,0"
                    VerticalAlignment="Center"
                    Background="White"
                    CornerRadius="5"
                    Visibility="Visible">
                    <TextBlock
                        x:Name="KeyLetterTextBlock"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="Black"
                        Text="X" />
                </Border>
            </StackPanel>
            <TextBlock
                x:Name="ErrorText"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Margin="0,6,0,0"
                d:Text="This is error message text"
                Style="{StaticResource TextBodyNormal}"
                TextWrapping="Wrap"
                Visibility="Collapsed" />
        </Grid>
    </Border>
</UserControl>

<Page
    x:Class="Text_Grab.Pages.LanguageSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="LanguageSettings"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Language Settings" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Windows AI OCR" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock
                Name="StatusTextBlock"
                Margin="0,2,6,0"
                FontWeight="Black"
                Style="{StaticResource TextBodyNormal}"
                Text="STATUS" />
            <TextBlock
                Name="ReasonTextBlock"
                Grid.Column="1"
                Margin="0,2,6,0"
                FontStyle="Italic"
                Style="{StaticResource TextBodyNormal}"
                Text="Reason"
                TextWrapping="Wrap" />
        </Grid>
        <ui:HyperlinkButton
            Name="StoreLink"
            Click="HyperlinkButton_Click"
            Content="Such as Text Grab in the Microsoft Store"
            NavigateUri="https://www.microsoft.com/en-us/p/text-grab/9mznkqj7sl0b?cid=WindowsAICheck"
            Visibility="Collapsed" />
        <TextBlock
            Margin="0,8,0,8"
            Style="{StaticResource TextBodyNormal}"
            TextWrapping="Wrap">
            Windows AI OCR is a new state-of-the-art OCR engine first introduced on Copilot+ PCs. It supports a wide range of styles and languages, as well as being more accurate.
        </TextBlock>

        <controls:SettingsCard
            Description="When enabled, Text Grab can use Windows AI to generate a description of an image instead of extracted OCR text."
            HeaderText="Show Windows AI Description as a language option"
            Icon="{ui:SymbolIcon BrainCircuit24}">
            <ui:ToggleSwitch
                x:Name="WindowsAiDescriptionEnabledToggle"
                Checked="WindowsAiDescriptionEnabledToggle_Checked"
                Unchecked="WindowsAiDescriptionEnabledToggle_Checked" />
        </controls:SettingsCard>
        <ui:HyperlinkButton
            Click="HyperlinkButton_Click"
            Content="Learn more about Windows AI Foundry"
            NavigateUri="https://learn.microsoft.com/en-us/windows/ai/apis/" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Japanese &amp; Chinese (CJK) text" />

        <controls:SettingsExpander
            Description="Remove the small kana readings printed above kanji so they don't clutter OCR results."
            HeaderText="Remove furigana (ruby text) from Japanese and Chinese OCR"
            Icon="{ui:SymbolIcon LocalLanguage24}">
            <controls:SettingsExpander.SettingsContent>
                <ui:ToggleSwitch
                    x:Name="RemoveFuriganaToggle"
                    Checked="RemoveFuriganaToggle_Checked"
                    Unchecked="RemoveFuriganaToggle_Checked" />
            </controls:SettingsExpander.SettingsContent>
            <StackPanel>
                <TextBlock
                    Margin="0,0,0,8"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap">
                    Furigana are the small kana readings printed above kanji in Japanese (and similar ruby
                    annotations in Chinese). The OCR engine reads them as extra text, which clutters the
                    result. When enabled, Text Grab detects those small ruby lines by their size and position
                    and removes them, keeping only the main text.
                </TextBlock>
                <Border
                    Padding="12"
                    Background="#142A767E"
                    BorderBrush="#2A767E"
                    BorderThickness="1"
                    CornerRadius="6">
                    <TextBlock Style="{StaticResource TextBodyNormal}" TextWrapping="Wrap">
                        This is a work in progress. Furigana detection is based on a size-and-position
                        heuristic, so it can occasionally miss a reading or remove text it shouldn't. I'm
                        actively trying to improve how Text Grab handles Japanese and Chinese. If you have
                        experience with CJK text, OCR, or furigana and would be willing to help, please email
                        me at
                        <Hyperlink NavigateUri="mailto:joe@joefinapps.com" RequestNavigate="Hyperlink_RequestNavigate">joe@joefinapps.com</Hyperlink>. Thank you!
                    </TextBlock>
                </Border>
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Windows installed languages" />
        <!--  auto pull and parse which Windows Languages are installed  -->
        <ui:HyperlinkButton
            Click="HyperlinkButton_Click"
            Content="How to install OCR languages with PowerShell"
            NavigateUri="https://learn.microsoft.com/en-us/windows/powertoys/text-extractor#how-to-query-for-ocr-language-packs" />
        <!--  Show the commands to execute to add other languages  -->
        <ui:ListView
            x:Name="WindowsLanguagesListView"
            MaxWidth="600"
            HorizontalAlignment="Left">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <TextBlock Margin="4,2" Text="{Binding DisplayName}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ui:ListView>
        <StackPanel
            x:Name="TesseractLanguagesStackPanel"
            d:Visibility="Visible"
            Orientation="Vertical"
            Visibility="Collapsed">
            <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Tesseract languages" />
            <!--  auto pull and parse which Tesseract Languages are installed  -->
            <!--  if Tesseract wasn't found, don't show these options  -->
            <!--  Link to the GitHub Repo to download other languages  -->
            <ui:HyperlinkButton
                x:Name="OpenPathButton"
                HorizontalAlignment="Left"
                Click="OpenPathButton_Click">
                <StackPanel Margin="4,0" Orientation="Horizontal">
                    <ui:SymbolIcon Margin="0,0,6,0" Symbol="OpenFolder24" />
                    <TextBlock Text="Open Tesseract Language Data Folder" />
                </StackPanel>
            </ui:HyperlinkButton>
            <ui:ListView
                x:Name="TesseractLanguagesListView"
                MaxWidth="600"
                HorizontalAlignment="Left">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <TextBlock Margin="4,2" Text="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ui:ListView>

            <TextBlock Margin="0,20,0,0" Style="{StaticResource TextBodyNormal}">
                Download and install languages from Tesseract GitHub<LineBreak />
                <Hyperlink NavigateUri="https://github.com/tesseract-ocr/tessdata" RequestNavigate="Hyperlink_RequestNavigate">https://github.com/tesseract-ocr/tessdata</Hyperlink>
            </TextBlock>
            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                <ComboBox
                    x:Name="AllLanguagesComboBox"
                    Width="300"
                    IsEditable="True"
                    IsTextSearchCaseSensitive="False"
                    IsTextSearchEnabled="True">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Margin="12,0,0,0" Click="InstallButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Shield24" />
                        <TextBlock Margin="6,0,0,0" Text="Install" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <TextBlock
                x:Name="ErrorsAndOutputText"
                FontFamily="Cascadia Code"
                Style="{StaticResource TextBodyNormal}" />
        </StackPanel>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Direct Text (Beta)" />

        <controls:SettingsExpander
            Description="Try to read native accessibility text from live application controls before falling back to OCR."
            HeaderText="Show Direct Text (Beta) as a language option"
            Icon="{ui:SymbolIcon Beaker24}">
            <controls:SettingsExpander.SettingsContent>
                <ui:ToggleSwitch
                    x:Name="UiAutomationEnabledToggle"
                    Checked="UiAutomationEnabledToggle_Checked"
                    Unchecked="UiAutomationEnabledToggle_Checked" />
            </controls:SettingsExpander.SettingsContent>
            <StackPanel>
                <Border
                    Margin="0,0,0,10"
                    Padding="12"
                    Background="#14FFA500"
                    BorderBrush="DarkOrange"
                    BorderThickness="1"
                    CornerRadius="6">
                    <TextBlock
                        Style="{StaticResource TextBodyNormal}"
                        Text="Beta feature: Direct Text captures live accessibility text instead of performing normal OCR. It is off by default in this release and should be enabled only when you want to test this experimental path."
                        TextWrapping="Wrap" />
                </Border>
                <StackPanel x:Name="UiAutomationAdvancedOptionsPanel">
                    <ui:ToggleSwitch
                        x:Name="UiAutomationFallbackToggle"
                        Checked="UiAutomationFallbackToggle_Checked"
                        Unchecked="UiAutomationFallbackToggle_Checked">
                        <TextBlock Text="Fall back to OCR when UI Automation returns no text" TextWrapping="Wrap" />
                    </ui:ToggleSwitch>
                    <ui:ToggleSwitch
                        x:Name="UiAutomationPreferFocusedToggle"
                        Margin="0,8,0,0"
                        Checked="UiAutomationPreferFocusedToggle_Checked"
                        Unchecked="UiAutomationPreferFocusedToggle_Checked">
                        <TextBlock Text="Prefer the focused UI element before scanning the rest of the window" TextWrapping="Wrap" />
                    </ui:ToggleSwitch>
                    <ui:ToggleSwitch
                        x:Name="UiAutomationIncludeOffscreenToggle"
                        Margin="0,8,0,0"
                        Checked="UiAutomationIncludeOffscreenToggle_Checked"
                        Unchecked="UiAutomationIncludeOffscreenToggle_Checked">
                        <TextBlock Text="Include offscreen Direct Text elements" TextWrapping="Wrap" />
                    </ui:ToggleSwitch>
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <TextBlock
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Text="Traversal mode" />
                        <ComboBox
                            x:Name="UiAutomationTraversalModeComboBox"
                            Width="180"
                            SelectionChanged="UiAutomationTraversalModeComboBox_SelectionChanged" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Fast focuses on the closest useful elements, Balanced scans the visible subtree, and Thorough walks deeper through the automation tree."
                        TextWrapping="Wrap" />
                </StackPanel>
            </StackPanel>
        </controls:SettingsExpander>
    </StackPanel>
</Page>

<Page
    x:Class="Text_Grab.Pages.FullscreenGrabSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="FullscreenGrabSettings"
    AutomationProperties.AutomationId="Settings.FullscreenGrabPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Fullscreen Grab Settings" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Defaults" />

        <controls:SettingsExpander
            Description="Which capture mode Fullscreen Grab starts in."
            HeaderText="Start mode"
            Icon="{wpfui:SymbolIcon Play24}">
            <StackPanel>
                <RadioButton
                    x:Name="DefaultModeRadio"
                    AutomationProperties.AutomationId="Settings.FullscreenGrab.DefaultMode.Standard"
                    Click="DefaultModeRadio_Click"
                    GroupName="FsgStartMode">
                    Default (Standard)
                </RadioButton>
                <RadioButton
                    x:Name="SingleLineModeRadio"
                    AutomationProperties.AutomationId="Settings.FullscreenGrab.DefaultMode.SingleLine"
                    Click="SingleLineModeRadio_Click"
                    GroupName="FsgStartMode">
                    Single Line (S)
                </RadioButton>
                <RadioButton
                    x:Name="TableModeRadio"
                    AutomationProperties.AutomationId="Settings.FullscreenGrab.DefaultMode.Table"
                    Click="TableModeRadio_Click"
                    GroupName="FsgStartMode">
                    Table (T)
                </RadioButton>
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            Description="Choose how Fullscreen Grab defines the capture area by default. Region select is the standard drag-a-box capture."
            HeaderText="Selection style"
            Icon="{wpfui:SymbolIcon Crop24}">
            <StackPanel>
                <RadioButton
                    x:Name="RegionSelectionStyleRadio"
                    AutomationProperties.AutomationId="Settings.FullscreenGrab.SelectionStyle.Region"
                    Click="RegionSelectionStyleRadio_Click"
                    GroupName="FsgSelectionStyle">
                    <StackPanel Orientation="Horizontal">
                        <wpfui:SymbolIcon FontSize="22" Symbol="RectangleLandscape24" />
                        <TextBlock Margin="6,0,0,0">Region select (R)</TextBlock>
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="WindowSelectionStyleRadio"
                    AutomationProperties.AutomationId="Settings.FullscreenGrab.SelectionStyle.Window"
                    Click="WindowSelectionStyleRadio_Click"
                    GroupName="FsgSelectionStyle">
                    <StackPanel Orientation="Horizontal">
                        <wpfui:SymbolIcon FontSize="22" Symbol="WindowMultiple20" />
                        <TextBlock Margin="6,0,0,0">Window select (W)</TextBlock>
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="FreeformSelectionStyleRadio"
                    AutomationProperties.AutomationId="Settings.FullscreenGrab.SelectionStyle.Freeform"
                    Click="FreeformSelectionStyleRadio_Click"
                    GroupName="FsgSelectionStyle">
                    <StackPanel Orientation="Horizontal">
                        <wpfui:SymbolIcon FontSize="22" Symbol="DrawShape24" />
                        <TextBlock Margin="6,0,0,0">Draw freeform shape (D)</TextBlock>
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="AdjustAfterSelectionStyleRadio"
                    AutomationProperties.AutomationId="Settings.FullscreenGrab.SelectionStyle.AdjustAfter"
                    Click="AdjustAfterSelectionStyleRadio_Click"
                    GroupName="FsgSelectionStyle">
                    <StackPanel Orientation="Horizontal">
                        <wpfui:SymbolIcon FontSize="22" Symbol="SelectObject24" />
                        <TextBlock Margin="6,0,0,0">Adjust after region selection (A)</TextBlock>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsCard
            Description="Automatically route capture text into the Edit Text Window (same as pressing E)."
            HeaderText="Send output to Edit Text Window by default"
            Icon="{wpfui:SymbolIcon WindowEdit20}">
            <wpfui:ToggleSwitch x:Name="SendToEtwCheckBox" AutomationProperties.AutomationId="Settings.FullscreenGrab.SendToEditTextToggle" Click="SendToEtwCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Controls the transparent overlay shown during Fullscreen Grab selection. Turn off to disable screen dimming."
            HeaderText="Dim screen with translucent overlay while selecting"
            Icon="{wpfui:SymbolIcon DarkTheme24}">
            <wpfui:ToggleSwitch x:Name="ShadeOverlayCheckBox" AutomationProperties.AutomationId="Settings.FullscreenGrab.ShadeOverlayToggle" Click="ShadeOverlayCheckBox_Click" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Post-capture" />

        <controls:SettingsExpander
            Description="Paste captured text into the focused app after closing Fullscreen Grab."
            HeaderText="Insert captured text into the focused app"
            Icon="{wpfui:SymbolIcon ClipboardPaste24}">
            <controls:SettingsExpander.SettingsContent>
                <wpfui:ToggleSwitch x:Name="TryInsertCheckBox" AutomationProperties.AutomationId="Settings.FullscreenGrab.InsertToggle" Click="TryInsertCheckBox_Click" />
            </controls:SettingsExpander.SettingsContent>
            <StackPanel>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Insert delay (seconds):" />
                    <Slider
                        x:Name="InsertDelaySlider"
                        AutomationProperties.AutomationId="Settings.FullscreenGrab.InsertDelay"
                        Width="200"
                        Margin="12,0,0,0"
                        IsSnapToTickEnabled="True"
                        Maximum="5"
                        Minimum="0"
                        SmallChange="0.1"
                        TickFrequency="0.1"
                        ValueChanged="InsertDelaySlider_ValueChanged" />
                    <TextBlock
                        x:Name="InsertDelayValueText"
                        AutomationProperties.AutomationId="Settings.FullscreenGrab.InsertDelayValue"
                        Width="40"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="How long to wait before simulating paste (Ctrl+V)."
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            Description="Configure which actions are available for selection to perform after text is captured (Trim lines, Remove duplicates, etc.)."
            HeaderText="Post-capture actions"
            Icon="{wpfui:SymbolIcon TaskListSquareLtr24}">
            <StackPanel>
                <Button
                    x:Name="CustomizeActionsButton"
                    AutomationProperties.AutomationId="Settings.FullscreenGrab.CustomizeActionsButton"
                    HorizontalAlignment="Left"
                    Click="CustomizeActionsButton_Click"
                    Content="Customize Post-Capture Actions..."
                    ToolTip="Open editor to add, remove, and reorder post-capture actions" />
                <TextBlock
                    x:Name="ActionsCountText"
                    AutomationProperties.AutomationId="Settings.FullscreenGrab.ActionsStatus"
                    Margin="0,8,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Current actions: Loading..."
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsCard
            Description="Create reusable templates that OCR specific regions of a captured area and format the result using a template string like &quot;Name: {1}\nEmail: {2}&quot;."
            HeaderText="Grab Templates"
            Icon="{wpfui:SymbolIcon DocumentCopy24}">
            <Button
                x:Name="ManageTemplatesButton"
                AutomationProperties.AutomationId="Settings.FullscreenGrab.ManageTemplatesButton"
                Click="ManageTemplatesButton_Click"
                Content="Manage Grab Templates..."
                ToolTip="Open editor to create, edit, and delete grab templates" />
        </controls:SettingsCard>

    </StackPanel>
</Page>

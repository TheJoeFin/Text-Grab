<Page
    x:Class="Text_Grab.Pages.GeneralSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Text_Grab.Models"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GeneralSettings"
    d:DesignHeight="1450"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="General Settings" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="auto" />
            </Grid.ColumnDefinitions>
            <!--  Version Text  -->
            <TextBlock
                x:Name="VersionTextblock"
                VerticalAlignment="Center"
                Style="{StaticResource TextBodyNormal}"
                Text="Version X.X" />

            <ui:HyperlinkButton
                x:Name="OpenExeFolderButton"
                Grid.Column="1"
                Margin="12,0,0,0"
                VerticalAlignment="Bottom"
                Click="OpenExeFolderButton_Click"
                Foreground="{StaticResource Teal}"
                Visibility="Collapsed">
                <TextBlock Text="Open EXE Containing Folder" />
            </ui:HyperlinkButton>

            <controls:CollapsibleButton
                x:Name="AboutBTN"
                Grid.Column="3"
                Margin="0"
                ButtonSymbol="Info24"
                ButtonText="About Text Grab"
                Click="AboutBTN_Click" />
        </Grid>

        <Border
            Margin="0,20"
            Padding="20,12,20,20"
            Background="{ui:ThemeResource SolidBackgroundFillColorBaseBrush}"
            CornerRadius="8">
            <StackPanel Orientation="Vertical">
                <TextBlock Style="{StaticResource TextHeader}" Text="Hello there!" />
                <TextBlock Style="{StaticResource TextBodyNormal}">
                    Thank you for using Text Grab!
                    Building this application is very much a labor of love. I am always happy to hear from users to better understand how you use the app and what you would like to see in the future.<LineBreak />
                    Feel free to open an issue on GitHub if you have a bug or feature request. Email me directly for questions or just to say hi.<LineBreak />
                    Happy Text Grabbing!</TextBlock>
                <TextBlock
                    Margin="0,12"
                    HorizontalAlignment="Left"
                    Style="{StaticResource TextBodyNormal}"
                    Text="- Joe" />
                <ui:HyperlinkButton Foreground="{StaticResource Teal}" NavigateUri="https://github.com/TheJoeFin/Text-Grab/issues">
                    🌐 https://github.com/TheJoeFin/Text-Grab/issues
                </ui:HyperlinkButton>
                <ui:HyperlinkButton Foreground="{StaticResource Teal}" NavigateUri="mailto:joe@JoeFinApps.com">
                    📧 joe@JoeFinApps.com
                </ui:HyperlinkButton>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Appearance" />

        <controls:SettingsExpander
            Description="Choose whether Text Grab follows the Windows theme or always uses light or dark."
            HeaderText="Text Grab theme"
            Icon="{ui:SymbolIcon Color24}">
            <StackPanel>
                <RadioButton
                    x:Name="SystemThemeRdBtn"
                    Checked="SystemThemeRdBtn_Checked"
                    Content="System"
                    GroupName="ThemeGroup" />
                <RadioButton
                    x:Name="LightThemeRdBtn"
                    Checked="LightThemeRdBtn_Checked"
                    Content="Light"
                    GroupName="ThemeGroup" />
                <RadioButton
                    x:Name="DarkThemeRdBtn"
                    Checked="DarkThemeRdBtn_Checked"
                    Content="Dark"
                    GroupName="ThemeGroup" />
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Behavior" />

        <controls:SettingsCard
            Description="Clicking the notification opens the copied text into a new Edit Text Window to display and edit text."
            HeaderText="Show notification when text is copied"
            Icon="{ui:SymbolIcon Alert24}">
            <ui:ToggleSwitch
                Name="ShowToastCheckBox"
                Checked="ShowToastCheckBox_Checked"
                Unchecked="ShowToastCheckBox_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="Which window opens when launching Text Grab."
            HeaderText="Default launch window"
            Icon="{ui:SymbolIcon AppFolder24}">
            <StackPanel>
                <RadioButton
                    x:Name="FullScreenRDBTN"
                    Checked="FullScreenRDBTN_Checked"
                    GroupName="DefaultLaunch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="SlideAdd20" />
                        <TextBlock VerticalAlignment="Center" Text="Full Screen" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="GrabFrameRDBTN"
                    Checked="GrabFrameRDBTN_Checked"
                    GroupName="DefaultLaunch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="PanelBottom20" />
                        <TextBlock VerticalAlignment="Center" Text="Grab Frame" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="EditTextRDBTN"
                    Checked="EditTextRDBTN_Checked"
                    GroupName="DefaultLaunch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="Window20" />
                        <TextBlock VerticalAlignment="Center" Text="Edit Text Window" />
                    </StackPanel>
                </RadioButton>
                <RadioButton
                    x:Name="QuickLookupRDBTN"
                    Checked="QuickLookupRDBTN_Checked"
                    GroupName="DefaultLaunch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            Symbol="SlideSearch20" />
                        <TextBlock VerticalAlignment="Center" Text="Quick Simple Lookup" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsCard
            Description="Run Text Grab in the background and enable hotkeys."
            HeaderText="Run in the background"
            Icon="{ui:SymbolIcon Desktop24}">
            <ui:ToggleSwitch
                Name="RunInBackgroundChkBx"
                Checked="RunInBackgroundChkBx_Checked"
                Unchecked="RunInBackgroundChkBx_Checked" />
        </controls:SettingsCard>

        <controls:SettingsCard HeaderText="Auto start Text Grab when you login" Icon="{ui:SymbolIcon Power24}">
            <ui:ToggleSwitch
                Name="StartupOnLoginCheckBox"
                Checked="StartupOnLoginCheckBox_Checked"
                Unchecked="StartupOnLoginCheckBox_Unchecked" />
        </controls:SettingsCard>
        <TextBlock
            x:Name="StartupTextBlock"
            Margin="1,0,0,8"
            FontSize="12"
            Foreground="{DynamicResource TextFillColorSecondaryBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Integrations" />

        <controls:SettingsCard
            Description="Right-click on supported image files or PDFs to quickly grab text."
            HeaderText="Add &quot;Grab text with Text Grab&quot; to the right-click menu"
            Icon="{ui:SymbolIcon CursorClick24}">
            <ui:ToggleSwitch
                Name="AddToContextMenuCheckBox"
                Checked="AddToContextMenuCheckBox_Checked"
                Unchecked="AddToContextMenuCheckBox_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Opens supported images and PDFs directly in Grab Frame when using &quot;Open with&quot; from File Explorer."
            HeaderText="Register Text Grab as an &quot;Open with&quot; app for image and PDF files"
            Icon="{ui:SymbolIcon Open24}">
            <ui:ToggleSwitch
                Name="RegisterOpenWithCheckBox"
                Checked="RegisterOpenWithCheckBox_Checked"
                Unchecked="RegisterOpenWithCheckBox_Unchecked" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Capture" />

        <controls:SettingsCard
            Description="Try to read barcodes and QR codes when capturing. Disabling may speed up results."
            HeaderText="Read barcodes and QR codes"
            Icon="{ui:SymbolIcon BarcodeScanner24}">
            <ui:ToggleSwitch
                Name="ReadBarcodesBarcode"
                Checked="ReadBarcodesBarcode_Checked"
                Unchecked="ReadBarcodesBarcode_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="Captures HDR screens at full range and tone-maps them back to SDR so text isn't overly bright. Only affects monitors with HDR turned on."
            HeaderText="Correct washed-out captures on HDR displays"
            Icon="{ui:SymbolIcon Hdr24}">
            <controls:SettingsExpander.SettingsContent>
                <ui:ToggleSwitch
                    Name="HdrCaptureCorrectionToggle"
                    Checked="HdrCaptureCorrectionToggle_Checked"
                    Unchecked="HdrCaptureCorrectionToggle_Unchecked" />
            </controls:SettingsExpander.SettingsContent>
            <StackPanel>
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Removing the yellow capture border needs Windows &quot;borderless capture&quot; permission. Use Check permissions to grant it."
                    TextWrapping="Wrap" />
                <ui:Button
                    Name="CheckHdrPermissionButton"
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    Click="CheckHdrPermissionButton_Click"
                    Content="Check permissions" />
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsCard HeaderText="Web search engine" Icon="{ui:SymbolIcon Search24}">
            <ComboBox
                x:Name="WebSearchersComboBox"
                Width="240"
                IsTextSearchCaseSensitive="False"
                SelectionChanged="WebSearchersComboBox_SelectionChanged">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Correct common errors" />

        <controls:SettingsCard HeaderText="Detect paragraph wrapping — join wrapped lines into one paragraph" Icon="{ui:SymbolIcon TextParagraph24}">
            <ui:ToggleSwitch
                Name="ParagraphDetectionToggle"
                Checked="ParagraphDetectionToggle_Checked"
                Unchecked="ParagraphDetectionToggle_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsCard HeaderText="Correct common confusions between numbers and letters" Icon="{ui:SymbolIcon Wand24}">
            <ui:ToggleSwitch
                Name="ErrorCorrectBox"
                Checked="ErrorCorrectBox_Checked"
                Unchecked="ErrorCorrectBox_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsCard HeaderText="Correct misidentifications between Greek and Cyrillic to Latin letters" Icon="{ui:SymbolIcon TextT24}">
            <ui:ToggleSwitch
                Name="CorrectToLatin"
                Checked="CorrectToLatin_Checked"
                Unchecked="CorrectToLatin_Unchecked" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Clipboard" />

        <controls:SettingsCard HeaderText="Never automatically add text to the clipboard" Icon="{ui:SymbolIcon ClipboardLetter24}">
            <ui:ToggleSwitch
                Name="NeverUseClipboardChkBx"
                Checked="NeverUseClipboardChkBx_Checked"
                Unchecked="NeverUseClipboardChkBx_Unchecked" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="After a Fullscreen Grab, wait and then paste the captured text into the focused text field."
            HeaderText="Try to insert text in text fields after Fullscreen Grab"
            Icon="{ui:SymbolIcon ClipboardPaste24}">
            <controls:SettingsExpander.SettingsContent>
                <ui:ToggleSwitch
                    Name="TryInsertCheckbox"
                    Checked="TryInsertCheckbox_Checked"
                    Unchecked="TryInsertCheckbox_Unchecked" />
            </controls:SettingsExpander.SettingsContent>
            <StackPanel Orientation="Horizontal">
                <TextBlock VerticalAlignment="Center" Text="Insert after" />
                <TextBox
                    x:Name="SecondsTextBox"
                    Width="40"
                    Height="26"
                    Margin="8,0,0,0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="White"
                    FontWeight="Medium"
                    Foreground="Black"
                    Style="{StaticResource TextBoxStyle1}"
                    Text="0.5"
                    TextChanged="ValidateTextIsNumber" />
                <TextBlock
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Text="seconds" />
                <TextBlock
                    x:Name="DelayTimeErrorSeconds"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Text="⚠ Pick a number between 0 and 10"
                    Visibility="Collapsed" />
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="History" />

        <controls:SettingsCard
            Description="Keep recent history of Grabs and Edit Text Windows."
            HeaderText="Keep history"
            Icon="{ui:SymbolIcon History24}">
            <ui:ToggleSwitch
                Name="HistorySwitch"
                Checked="HistorySwitch_Checked"
                Unchecked="HistorySwitch_Unchecked" />
        </controls:SettingsCard>

    </StackPanel>
</Page>

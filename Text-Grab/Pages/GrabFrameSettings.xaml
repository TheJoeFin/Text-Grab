<Page
    x:Class="Text_Grab.Pages.GrabFrameSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="GrabFrameSettings"
    AutomationProperties.AutomationId="Settings.GrabFramePage"
    d:DesignHeight="700"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Grab Frame Settings" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Capture behavior" />

        <controls:SettingsCard
            Description="Freeze and run OCR automatically after dragging the frame. When off, a manual OCR button is shown instead of the Refresh button."
            HeaderText="Automatically run OCR on capture"
            Icon="{ui:SymbolIcon ScanText24}">
            <ui:ToggleSwitch x:Name="GrabFrameAutoOcrCheckBox" AutomationProperties.AutomationId="Settings.GrabFrame.AutoOcrToggle" Click="GrabFrameAutoOcrCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="When grabbing, replace the current selection in the Edit Text Window with captured text. When off, text is appended instead."
            HeaderText="Update Edit Text Window on each grab"
            Icon="{ui:SymbolIcon WindowEdit20}">
            <ui:ToggleSwitch x:Name="GrabFrameUpdateEtwCheckBox" AutomationProperties.AutomationId="Settings.GrabFrame.UpdateEditTextToggle" Click="GrabFrameUpdateEtwCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Automatically close the Grab Frame window after a grab or trim executes."
            HeaderText="Close Grab Frame after grabbing text"
            Icon="{ui:SymbolIcon DismissSquare24}">
            <ui:ToggleSwitch x:Name="CloseFrameOnGrabCheckBox" AutomationProperties.AutomationId="Settings.GrabFrame.CloseAfterGrabToggle" Click="CloseFrameOnGrabCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="Controls what the mouse scroll wheel does while the Grab Frame is active."
            HeaderText="Scroll wheel behavior"
            Icon="{ui:SymbolIcon CursorHover24}">
            <StackPanel>
                <RadioButton
                    x:Name="NoneScrollRadio"
                    AutomationProperties.AutomationId="Settings.GrabFrame.Scroll.None"
                    Click="ScrollBehaviorRadio_Click"
                    GroupName="GfScrollBehavior">
                    None — scroll wheel does nothing
                </RadioButton>
                <RadioButton
                    x:Name="ResizeScrollRadio"
                    AutomationProperties.AutomationId="Settings.GrabFrame.Scroll.Resize"
                    Click="ScrollBehaviorRadio_Click"
                    GroupName="GfScrollBehavior">
                    Resize — scroll wheel resizes the frame
                </RadioButton>
                <RadioButton
                    x:Name="ZoomScrollRadio"
                    AutomationProperties.AutomationId="Settings.GrabFrame.Scroll.Zoom"
                    Click="ScrollBehaviorRadio_Click"
                    GroupName="GfScrollBehavior">
                    Zoom — scroll wheel zooms the captured image
                </RadioButton>
                <RadioButton
                    x:Name="ZoomWhenFrozenScrollRadio"
                    AutomationProperties.AutomationId="Settings.GrabFrame.Scroll.ZoomWhenFrozen"
                    Click="ScrollBehaviorRadio_Click"
                    GroupName="GfScrollBehavior">
                    Zoom when frozen — zoom only after freezing the frame
                </RadioButton>
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Barcodes" />

        <controls:SettingsCard
            Description="Scan for barcodes and QR codes alongside OCR text. Each barcode found appears as its own selectable word border."
            HeaderText="Read barcodes in Grab Frame"
            Icon="{ui:SymbolIcon BarcodeScanner24}">
            <ui:ToggleSwitch x:Name="GrabFrameReadBarcodesCheckBox" AutomationProperties.AutomationId="Settings.GrabFrame.ReadBarcodesToggle" Click="GrabFrameReadBarcodesCheckBox_Click" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Translation" />

        <controls:SettingsExpander
            Description="Translates captured text in place using on-device Windows AI — no internet required."
            HeaderText="Enable translation overlay (requires Windows AI)"
            Icon="{ui:SymbolIcon Translate24}">
            <controls:SettingsExpander.SettingsContent>
                <ui:ToggleSwitch x:Name="GrabFrameTranslationCheckBox" AutomationProperties.AutomationId="Settings.GrabFrame.TranslationToggle" Click="GrabFrameTranslationCheckBox_Click" />
            </controls:SettingsExpander.SettingsContent>
            <StackPanel>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Translation language:" />
                    <TextBox
                        x:Name="GrabFrameTranslationLanguageText"
                        AutomationProperties.AutomationId="Settings.GrabFrame.TranslationLanguage"
                        Width="180"
                        Margin="12,0,0,0"
                        LostFocus="GrabFrameTranslationLanguageText_LostFocus" />
                </StackPanel>
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Enter the target language name (e.g. English, French, Spanish)."
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Frame border" />

        <controls:SettingsExpander
            Description="Controls how the Grab Frame outline is drawn. High contrast keeps the frame easy to locate over dark or busy content."
            HeaderText="Frame border style"
            Icon="{ui:SymbolIcon BorderOutside24}">
            <StackPanel>
                <RadioButton
                    x:Name="ThemeBorderRadio"
                    Click="BorderStyleRadio_Click"
                    GroupName="GfBorderStyle">
                    Theme — follows the app light/dark theme (default)
                </RadioButton>
                <RadioButton
                    x:Name="HighContrastBorderRadio"
                    Click="BorderStyleRadio_Click"
                    GroupName="GfBorderStyle">
                    High contrast — black &amp; white, visible on any background
                </RadioButton>
                <RadioButton
                    x:Name="ColorBorderRadio"
                    Click="BorderStyleRadio_Click"
                    GroupName="GfBorderStyle">
                    Pick a color
                </RadioButton>

                <WrapPanel x:Name="BorderColorSwatchPanel" Margin="24,6,0,0">
                    <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,6,6"
                        Padding="2"
                        Click="BorderColorSwatch_Click"
                        Tag="#2A767E"
                        ToolTip="Teal">
                        <Border Width="20" Height="20" Background="#2A767E" CornerRadius="3" />
                    </Button>
                    <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,6,6"
                        Padding="2"
                        Click="BorderColorSwatch_Click"
                        Tag="#E03B3B"
                        ToolTip="Red">
                        <Border Width="20" Height="20" Background="#E03B3B" CornerRadius="3" />
                    </Button>
                    <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,6,6"
                        Padding="2"
                        Click="BorderColorSwatch_Click"
                        Tag="#E0781E"
                        ToolTip="Orange">
                        <Border Width="20" Height="20" Background="#E0781E" CornerRadius="3" />
                    </Button>
                    <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,6,6"
                        Padding="2"
                        Click="BorderColorSwatch_Click"
                        Tag="#E0C81E"
                        ToolTip="Yellow">
                        <Border Width="20" Height="20" Background="#E0C81E" CornerRadius="3" />
                    </Button>
                    <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,6,6"
                        Padding="2"
                        Click="BorderColorSwatch_Click"
                        Tag="#3BB143"
                        ToolTip="Green">
                        <Border Width="20" Height="20" Background="#3BB143" CornerRadius="3" />
                    </Button>
                    <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,6,6"
                        Padding="2"
                        Click="BorderColorSwatch_Click"
                        Tag="#2A7EE0"
                        ToolTip="Blue">
                        <Border Width="20" Height="20" Background="#2A7EE0" CornerRadius="3" />
                    </Button>
                    <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,6,6"
                        Padding="2"
                        Click="BorderColorSwatch_Click"
                        Tag="#8A5CD1"
                        ToolTip="Purple">
                        <Border Width="20" Height="20" Background="#8A5CD1" CornerRadius="3" />
                    </Button>
                    <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,6,6"
                        Padding="2"
                        Click="BorderColorSwatch_Click"
                        Tag="#FFFFFF"
                        ToolTip="White">
                        <Border Width="20" Height="20" Background="#FFFFFF" CornerRadius="3" />
                    </Button>
                    <Button
                        Width="30"
                        Height="30"
                        Margin="0,0,6,6"
                        Padding="2"
                        Click="BorderColorSwatch_Click"
                        Tag="#000000"
                        ToolTip="Black">
                        <Border Width="20" Height="20" Background="#000000" CornerRadius="3" />
                    </Button>
                </WrapPanel>
            </StackPanel>
        </controls:SettingsExpander>

    </StackPanel>
</Page>

<Page
    x:Class="Text_Grab.Pages.DangerSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DangerSettings"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Dangerous Options" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="App" />

        <controls:SettingsCard HeaderText="Shutdown Text Grab" Icon="{ui:SymbolIcon Power24}">
            <controls:CollapsibleButton
                x:Name="ShutdownButton"
                Margin="0"
                ButtonSymbol="Power24"
                ButtonText="Shutdown Text Grab"
                Click="ShutdownButton_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard HeaderText="Reset Tray icon" Icon="{ui:SymbolIcon ArrowClockwise24}">
            <controls:CollapsibleButton
                x:Name="RetrySettingTrayButton"
                Margin="0"
                ButtonSymbol="ArrowClockwise24"
                ButtonText="Reset Tray Icon"
                Click="RetrySettingTrayButton_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Generate bug report with app diagnostic information."
            HeaderText="Export bug report"
            Icon="{ui:SymbolIcon Bug24}">
            <controls:CollapsibleButton
                x:Name="ExportBugReportButton"
                Margin="0"
                ButtonSymbol="Bug24"
                ButtonText="Export Bug Report"
                Click="ExportBugReportButton_Click" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Backup and restore" />

        <controls:SettingsExpander
            Description="Export all settings and optionally history to a portable ZIP file."
            HeaderText="Export settings"
            Icon="{ui:SymbolIcon SaveArrowRight24}">
            <controls:SettingsExpander.SettingsContent>
                <controls:CollapsibleButton
                    x:Name="ExportSettingsButton"
                    Margin="0"
                    ButtonSymbol="FolderZip24"
                    ButtonText="Export Settings"
                    Click="ExportSettingsButton_Click" />
            </controls:SettingsExpander.SettingsContent>
            <CheckBox
                x:Name="IncludeHistoryCheckBox"
                Content="Include history (images and text)"
                IsChecked="True" />
        </controls:SettingsExpander>

        <controls:SettingsCard
            Description="Import settings and history from a previously exported ZIP file."
            HeaderText="Import settings"
            Icon="{ui:SymbolIcon ArrowImport24}">
            <controls:CollapsibleButton
                x:Name="ImportSettingsButton"
                Margin="0"
                ButtonSymbol="ArrowImport24"
                ButtonText="Import Settings"
                Click="ImportSettingsButton_Click" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Experimental" />

        <Border
            Padding="12"
            Background="#14FFA500"
            BorderBrush="DarkOrange"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    FontWeight="Bold"
                    Style="{StaticResource TextBodyNormal}"
                    Text="Experimental file-backed settings storage" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource TextBodyNormal}"
                    TextWrapping="Wrap">
                    <Run Text="This transition feature keeps a second file-backed copy of large settings and can reduce Text Grab's RAM usage by moving large settings payloads out of the main settings store. It is off by default for rollback safety." />
                    <LineBreak />
                    <Hyperlink Click="BackupSettingsHyperlink_Click">Backup your settings</Hyperlink>
                    <Run Text=" before enabling it, then restart Text Grab. The restart applies the new storage preference on launch so Text Grab can keep the legacy strings and the file-backed copies in sync." />
                </TextBlock>
                <ui:ToggleSwitch
                    x:Name="EnableFileBackedManagedSettingsToggle"
                    Margin="0,10,0,0"
                    Checked="EnableFileBackedManagedSettingsToggle_Checked"
                    Unchecked="EnableFileBackedManagedSettingsToggle_Checked">
                    <TextBlock Style="{StaticResource TextBodyNormal}">
                        Enable experimental file-backed settings storage (restart required)
                    </TextBlock>
                </ui:ToggleSwitch>
            </StackPanel>
        </Border>

        <controls:SettingsCard
            Margin="0,8,0,3"
            Description="Windows Local AI model features normally require an ARM CPU. Override the check to allow any architecture."
            HeaderText="Check CPU architecture before enabling Windows Local AI model features"
            Icon="{ui:SymbolIcon BrainCircuit24}">
            <ui:ToggleSwitch
                x:Name="OverrideArchCheckWinAI"
                Click="OverrideArchCheckWinAI_Click"
                OffContent="ARM CPU only"
                OnContent="No CPU Arch is checked" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Reset" />

        <controls:SettingsCard
            Description="Reset all settings to default settings."
            HeaderText="Reset all settings"
            Icon="{ui:SymbolIcon ArrowReset24}">
            <controls:CollapsibleButton
                x:Name="ResetSettingsButton"
                Margin="0"
                Background="DarkRed"
                ButtonSymbol="ArrowCounterclockwise24"
                ButtonText="Reset All Settings"
                Click="ResetSettingsButton_Click" />
        </controls:SettingsCard>

        <!--  Add how many history items exist to be deleted  -->
        <controls:SettingsCard
            Description="Delete all history items."
            HeaderText="Clear history"
            Icon="{ui:SymbolIcon Delete24}">
            <controls:CollapsibleButton
                x:Name="ClearHistoryButton"
                Margin="0"
                Background="DarkRed"
                ButtonSymbol="Delete24"
                ButtonText="Clear History"
                Click="ClearHistoryButton_Click" />
        </controls:SettingsCard>
    </StackPanel>
</Page>

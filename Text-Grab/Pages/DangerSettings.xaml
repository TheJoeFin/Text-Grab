<Page
    x:Class="Text_Grab.Pages.DangerSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="DangerSettings"
    AutomationProperties.AutomationId="Settings.DangerPage"
    d:DesignHeight="450"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Dangerous Options" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="App" />

        <controls:SettingsCard HeaderText="Shutdown Text Grab" Icon="{ui:SymbolIcon Power24}">
            <controls:CollapsibleButton
                x:Name="ShutdownButton"
                AutomationProperties.AutomationId="Settings.Danger.ShutdownButton"
                Margin="0"
                ButtonSymbol="Power24"
                ButtonText="Shutdown Text Grab"
                Click="ShutdownButton_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard HeaderText="Reset Tray icon" Icon="{ui:SymbolIcon ArrowClockwise24}">
            <controls:CollapsibleButton
                x:Name="RetrySettingTrayButton"
                AutomationProperties.AutomationId="Settings.Danger.ResetTrayButton"
                Margin="0"
                ButtonSymbol="ArrowClockwise24"
                ButtonText="Reset Tray Icon"
                Click="RetrySettingTrayButton_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Generate bug report with app diagnostic information."
            HeaderText="Export bug report"
            Icon="{ui:SymbolIcon Bug24}">
            <controls:CollapsibleButton
                x:Name="ExportBugReportButton"
                AutomationProperties.AutomationId="Settings.Danger.ExportBugReportButton"
                Margin="0"
                ButtonSymbol="Bug24"
                ButtonText="Export Bug Report"
                Click="ExportBugReportButton_Click" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Backup and restore" />

        <controls:SettingsExpander
            Description="Export all settings and optionally history to a portable ZIP file."
            HeaderText="Export settings"
            Icon="{ui:SymbolIcon SaveArrowRight24}">
            <controls:SettingsExpander.SettingsContent>
                <controls:CollapsibleButton
                    x:Name="ExportSettingsButton"
                    AutomationProperties.AutomationId="Settings.Danger.ExportSettingsButton"
                    Margin="0"
                    ButtonSymbol="FolderZip24"
                    ButtonText="Export Settings"
                    Click="ExportSettingsButton_Click" />
            </controls:SettingsExpander.SettingsContent>
            <CheckBox
                x:Name="IncludeHistoryCheckBox"
                AutomationProperties.AutomationId="Settings.Danger.IncludeHistoryToggle"
                Content="Include history (images and text)"
                IsChecked="True" />
        </controls:SettingsExpander>

        <controls:SettingsCard
            Description="Import settings and history from a previously exported ZIP file."
            HeaderText="Import settings"
            Icon="{ui:SymbolIcon ArrowImport24}">
            <controls:CollapsibleButton
                x:Name="ImportSettingsButton"
                AutomationProperties.AutomationId="Settings.Danger.ImportSettingsButton"
                Margin="0"
                ButtonSymbol="ArrowImport24"
                ButtonText="Import Settings"
                Click="ImportSettingsButton_Click" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Experimental" />

        <Border
            Padding="12"
            Background="#14FFA500"
            BorderBrush="DarkOrange"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    FontWeight="Bold"
                    Style="{StaticResource TextBodyNormal}"
                    Text="Experimental file-backed settings storage" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource TextBodyNormal}"
                    TextWrapping="Wrap">
                    <Run Text="This transition feature keeps a second file-backed copy of large settings and can reduce Text Grab's RAM usage by moving large settings payloads out of the main settings store. It is off by default for rollback safety." />
                    <LineBreak />
                    <Hyperlink Click="BackupSettingsHyperlink_Click">Backup your settings</Hyperlink>
                    <Run Text=" before enabling it, then restart Text Grab. The restart applies the new storage preference on launch so Text Grab can keep the legacy strings and the file-backed copies in sync." />
                </TextBlock>
                <ui:ToggleSwitch
                    x:Name="EnableFileBackedManagedSettingsToggle"
                    AutomationProperties.AutomationId="Settings.Danger.FileBackedStorageToggle"
                    Margin="0,10,0,0"
                    Checked="EnableFileBackedManagedSettingsToggle_Checked"
                    Unchecked="EnableFileBackedManagedSettingsToggle_Checked">
                    <TextBlock Style="{StaticResource TextBodyNormal}">
                        Enable experimental file-backed settings storage (restart required)
                    </TextBlock>
                </ui:ToggleSwitch>
            </StackPanel>
        </Border>

        <Border
            Margin="0,8,0,0"
            Padding="12"
            Background="#14FFA500"
            BorderBrush="DarkOrange"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel>
                <TextBlock
                    FontWeight="Bold"
                    Style="{StaticResource TextBodyNormal}"
                    Text="Fully portable mode" />
                <TextBlock
                    Margin="0,6,0,0"
                    Style="{StaticResource TextBodyNormal}"
                    TextWrapping="Wrap"
                    Text="Keeps everything - settings, history, downloaded Whisper models, logs - in Text Grab's own folder instead of AppData, and skips registry-based OS integration (startup on login, context menu, file/protocol associations) so nothing is left behind outside that folder. Only applies to unpackaged installs. Resolve each item below - each has its own fix-it button - then enable." />

                <StackPanel x:Name="PortableChecklistPanel" Margin="0,10,0,0">
                    <Border
                        Padding="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                x:Name="FileBackedStatusIcon"
                                Grid.Column="0"
                                Margin="0,2,8,0"
                                VerticalAlignment="Top"
                                Filled="True" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource TextBodyNormal}" Text="File-backed settings storage" />
                                <TextBlock
                                    x:Name="FileBackedDetailText"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="FileBackedFixButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="Settings.Danger.Portable.FileBacked.Fix"
                                Click="FileBackedFixButton_Click"
                                Content="Enable" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,6,0,0"
                        Padding="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                x:Name="ModelsStatusIcon"
                                Grid.Column="0"
                                Margin="0,2,8,0"
                                VerticalAlignment="Top"
                                Filled="True" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource TextBodyNormal}" Text="Transcription models and logs" />
                                <TextBlock
                                    x:Name="ModelsDetailText"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="ModelsFixButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="Settings.Danger.Portable.Models.Fix"
                                Click="ModelsFixButton_Click"
                                Content="Move" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,6,0,0"
                        Padding="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                x:Name="StartupStatusIcon"
                                Grid.Column="0"
                                Margin="0,2,8,0"
                                VerticalAlignment="Top"
                                Filled="True" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource TextBodyNormal}" Text="Startup on login" />
                                <TextBlock
                                    x:Name="StartupDetailText"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="StartupFixButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="Settings.Danger.Portable.Startup.Fix"
                                Click="StartupFixButton_Click"
                                Content="Turn Off" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,6,0,0"
                        Padding="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                x:Name="RegistryStatusIcon"
                                Grid.Column="0"
                                Margin="0,2,8,0"
                                VerticalAlignment="Top"
                                Filled="True" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource TextBodyNormal}" Text="Registry-based OS integration" />
                                <TextBlock
                                    x:Name="RegistryDetailText"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="RegistryFixButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="Settings.Danger.Portable.Registry.Fix"
                                Click="RegistryFixButton_Click"
                                Content="Remove" />
                        </Grid>
                    </Border>

                    <Border
                        Margin="0,6,0,0"
                        Padding="8"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                x:Name="BackupStatusIcon"
                                Grid.Column="0"
                                Margin="0,2,8,0"
                                VerticalAlignment="Top"
                                Filled="True" />
                            <StackPanel Grid.Column="1">
                                <TextBlock FontWeight="SemiBold" Style="{StaticResource TextBodyNormal}" Text="Recent settings backup (optional)" />
                                <TextBlock
                                    x:Name="BackupDetailText"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                            <Button
                                x:Name="BackupFixButton"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="Settings.Danger.Portable.Backup.Fix"
                                Click="BackupFixButton_Click"
                                Content="Export Now" />
                        </Grid>
                    </Border>
                </StackPanel>

                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <Button
                        x:Name="RecheckPortableButton"
                        AutomationProperties.AutomationId="Settings.Danger.Portable.Recheck"
                        Click="RecheckPortableButton_Click"
                        Content="Recheck" />
                    <Button
                        x:Name="EnableFullyPortableButton"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="Settings.Danger.Portable.Enable"
                        Click="EnableFullyPortableButton_Click"
                        Content="Enable Fully Portable Mode" />
                    <Button
                        x:Name="DisableFullyPortableButton"
                        Margin="8,0,0,0"
                        AutomationProperties.AutomationId="Settings.Danger.Portable.Disable"
                        Click="DisableFullyPortableButton_Click"
                        Content="Turn Off Fully Portable Mode"
                        Visibility="Collapsed" />
                </StackPanel>
                <TextBlock
                    x:Name="PortableStatusText"
                    Margin="0,6,0,0"
                    Style="{StaticResource TextBodyNormal}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <controls:SettingsCard
            Margin="0,8,0,3"
            Description="Windows Local AI model features normally require an ARM CPU. Override the check to allow any architecture."
            HeaderText="Check CPU architecture before enabling Windows Local AI model features"
            Icon="{ui:SymbolIcon BrainCircuit24}">
            <ui:ToggleSwitch
                x:Name="OverrideArchCheckWinAI"
                AutomationProperties.AutomationId="Settings.Danger.OverrideWinAiArchitectureToggle"
                Click="OverrideArchCheckWinAI_Click"
                OffContent="ARM CPU only"
                OnContent="No CPU Arch is checked" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Reset" />

        <controls:SettingsCard
            Description="Reset all settings to default settings."
            HeaderText="Reset all settings"
            Icon="{ui:SymbolIcon ArrowReset24}">
            <controls:CollapsibleButton
                x:Name="ResetSettingsButton"
                AutomationProperties.AutomationId="Settings.Danger.ResetSettingsButton"
                Margin="0"
                Background="DarkRed"
                ButtonSymbol="ArrowCounterclockwise24"
                ButtonText="Reset All Settings"
                Click="ResetSettingsButton_Click" />
        </controls:SettingsCard>

        <!--  Add how many history items exist to be deleted  -->
        <controls:SettingsCard
            Description="Delete all history items."
            HeaderText="Clear history"
            Icon="{ui:SymbolIcon Delete24}">
            <controls:CollapsibleButton
                x:Name="ClearHistoryButton"
                AutomationProperties.AutomationId="Settings.Danger.ClearHistoryButton"
                Margin="0"
                Background="DarkRed"
                ButtonSymbol="Delete24"
                ButtonText="Clear History"
                Click="ClearHistoryButton_Click" />
        </controls:SettingsCard>
    </StackPanel>
</Page>

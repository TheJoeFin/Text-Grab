<Page
    x:Class="Text_Grab.Pages.EditTextWindowSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="EditTextWindowSettings"
    d:DesignHeight="900"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Edit Text Window Settings" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Window behavior" />

        <controls:SettingsCard
            Description="When opening an empty Edit Text Window, immediately trigger a Fullscreen Grab. The window restores from minimized once text is captured."
            HeaderText="Launch Fullscreen Grab on startup"
            Icon="{ui:SymbolIcon FullScreenMaximize24}">
            <ui:ToggleSwitch x:Name="EditWindowStartFullscreenCheckBox" Click="EditWindowStartFullscreenCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="The Edit Text Window will stay above all other windows."
            HeaderText="Keep window always on top"
            Icon="{ui:SymbolIcon Pin24}">
            <ui:ToggleSwitch x:Name="EditWindowIsOnTopCheckBox" Click="EditWindowIsOnTopCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Wrap long lines of text instead of scrolling horizontally."
            HeaderText="Enable word wrap"
            Icon="{ui:SymbolIcon TextWrap24}">
            <ui:ToggleSwitch x:Name="EditWindowIsWordWrapOnCheckBox" Click="EditWindowIsWordWrapOnCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Remember and restore the Edit Text Window's size and position between sessions."
            HeaderText="Restore window size and position on startup"
            Icon="{ui:SymbolIcon WindowLocationTarget20}">
            <ui:ToggleSwitch x:Name="RestoreEtwPositionsCheckBox" Click="RestoreEtwPositionsCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Convert Unix (LF) and classic Mac (CR) line endings to Windows (CRLF) when pasting text."
            HeaderText="Normalize to Windows line endings on paste"
            Icon="{ui:SymbolIcon TextParagraph24}">
            <ui:ToggleSwitch x:Name="EtwNormalizeLineEndingsOnPasteCheckBox" Click="EtwNormalizeLineEndingsOnPasteCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="Control when red squiggles appear under misspelled words in the Edit Text Window."
            HeaderText="Spell check"
            Icon="{ui:SymbolIcon TextGrammarCheckmark24}">
            <StackPanel>
                <RadioButton
                    x:Name="SpellCheckAutoRadio"
                    Click="SpellCheckModeRadio_Click"
                    Content="Auto"
                    GroupName="EtwSpellCheckMode"
                    Tag="Auto" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Turn spell check off automatically for very large documents or content with several long unspaced tokens (GUIDs, app manifests, base64), and on otherwise."
                    TextWrapping="Wrap" />

                <RadioButton
                    x:Name="SpellCheckAlwaysOnRadio"
                    Click="SpellCheckModeRadio_Click"
                    Content="Always on"
                    GroupName="EtwSpellCheckMode"
                    Tag="AlwaysOn" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Always spell check, regardless of the content."
                    TextWrapping="Wrap" />

                <RadioButton
                    x:Name="SpellCheckOffRadio"
                    Click="SpellCheckModeRadio_Click"
                    Content="Off"
                    GroupName="EtwSpellCheckMode"
                    Tag="Off" />
                <TextBlock
                    Margin="24,0,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Never spell check."
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Toolbar and UI" />

        <controls:SettingsCard
            Description="Collapse the bottom bar that contains status text, character info, regex buttons, and the language picker."
            HeaderText="Hide bottom toolbar"
            Icon="{ui:SymbolIcon PanelBottom20}">
            <ui:ToggleSwitch x:Name="EditWindowBottomBarIsHiddenCheckBox" Click="EditWindowBottomBarIsHiddenCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Add an OCR language selector control to the bottom bar."
            HeaderText="Show language picker in toolbar"
            Icon="{ui:SymbolIcon LocalLanguage24}">
            <ui:ToggleSwitch x:Name="EtwShowLangPickerCheckBox" Click="EtwShowLangPickerCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Add responsive horizontal padding to the text area (50–160px depending on window width) to improve readability on wider windows."
            HeaderText="Show text margins"
            Icon="{ui:SymbolIcon AutoFitWidth24}">
            <ui:ToggleSwitch x:Name="EtwUseMarginsCheckBox" Click="EtwUseMarginsCheckBox_Click" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Text" />

        <controls:SettingsExpander
            Description="Default font used when opening a new Edit Text Window."
            HeaderText="Default font"
            Icon="{ui:SymbolIcon TextFont24}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        VerticalAlignment="Center"
                        Text="Font family:" />
                    <TextBox
                        x:Name="FontFamilyTextBox"
                        Width="200"
                        Margin="12,0,0,0"
                        LostFocus="FontFamilyTextBox_LostFocus" />
                </StackPanel>

                <StackPanel
                    Margin="0,8,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        VerticalAlignment="Center"
                        Text="Font size:" />
                    <Slider
                        x:Name="FontSizeSlider"
                        Width="200"
                        Margin="12,0,0,0"
                        IsSnapToTickEnabled="True"
                        Maximum="72"
                        Minimum="8"
                        SmallChange="1"
                        TickFrequency="1"
                        ValueChanged="FontSizeSlider_ValueChanged" />
                    <TextBlock
                        x:Name="FontSizeValueText"
                        Width="36"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <CheckBox
                        x:Name="IsFontBoldCheckBox"
                        Click="IsFontBoldCheckBox_Click"
                        Content="Bold" />
                    <CheckBox
                        x:Name="IsFontItalicCheckBox"
                        Margin="16,0,0,0"
                        Click="IsFontItalicCheckBox_Click"
                        Content="Italic" />
                    <CheckBox
                        x:Name="IsFontUnderlineCheckBox"
                        Margin="16,0,0,0"
                        Click="IsFontUnderlineCheckBox_Click"
                        Content="Underline" />
                    <CheckBox
                        x:Name="IsFontStrikeoutCheckBox"
                        Margin="16,0,0,0"
                        Click="IsFontStrikeoutCheckBox_Click"
                        Content="Strikeout" />
                </StackPanel>
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            Description="Choose which details appear as clickable buttons in the Edit Text Window status bar."
            HeaderText="Status bar details"
            Icon="{ui:SymbolIcon AppsListDetail24}">
            <StackPanel>
                <CheckBox
                    x:Name="EtwShowWordCountCheckBox"
                    Click="EtwShowWordCountCheckBox_Click"
                    Content="Show word count" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Adds word count alongside the cursor line and column in the status bar (e.g. &quot;Wrds 42, Ln 3, Col 7&quot;)."
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="EtwShowCharDetailsCheckBox"
                    Click="EtwShowCharDetailsCheckBox_Click"
                    Content="Show character details" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="For a single selected character, shows its Unicode code point (e.g. U+0041). For a longer selection, shows the character count."
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="EtwShowMatchCountCheckBox"
                    Click="EtwShowMatchCountCheckBox_Click"
                    Content="Show exact match count" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Searches the full text for exact copies of the current selection. Click the count to open Find and Replace."
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="EtwShowRegexPatternCheckBox"
                    Click="EtwShowRegexPatternCheckBox_Click"
                    Content="Show generated regex pattern" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Displays a regex pattern derived from the current selection. Scroll the mouse wheel over the button to adjust match precision."
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="EtwShowSimilarMatchesCheckBox"
                    Click="EtwShowSimilarMatchesCheckBox_Click"
                    Content="Show similar text matches" />
                <TextBlock
                    Margin="24,0,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Counts other text that matches the same character-class pattern as the selection. Scroll the mouse wheel over the button to adjust match precision."
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Calculator" />

        <controls:SettingsCard
            Description="Show a right-side panel that evaluates math expressions as you type them in the editor."
            HeaderText="Show calculator pane"
            Icon="{ui:SymbolIcon Calculator24}">
            <ui:ToggleSwitch x:Name="CalcShowPaneCheckBox" Click="CalcShowPaneCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Display expression evaluation errors inline in the calculator pane."
            HeaderText="Show calculator errors"
            Icon="{ui:SymbolIcon ErrorCircle24}">
            <ui:ToggleSwitch x:Name="CalcShowErrorsCheckBox" Click="CalcShowErrorsCheckBox_Click" />
        </controls:SettingsCard>

    </StackPanel>
</Page>

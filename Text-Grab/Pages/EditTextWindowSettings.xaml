<Page
    x:Class="Text_Grab.Pages.EditTextWindowSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="EditTextWindowSettings"
    AutomationProperties.AutomationId="Settings.EditTextPage"
    d:DesignHeight="900"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Edit Text Window Settings" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Window behavior" />

        <controls:SettingsCard
            Description="When opening an empty Edit Text Window, immediately trigger a Fullscreen Grab. The window restores from minimized once text is captured."
            HeaderText="Launch Fullscreen Grab on startup"
            Icon="{ui:SymbolIcon FullScreenMaximize24}">
            <ui:ToggleSwitch x:Name="EditWindowStartFullscreenCheckBox" AutomationProperties.AutomationId="Settings.EditText.StartFullscreenToggle" Click="EditWindowStartFullscreenCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="The Edit Text Window will stay above all other windows."
            HeaderText="Keep window always on top"
            Icon="{ui:SymbolIcon Pin24}">
            <ui:ToggleSwitch x:Name="EditWindowIsOnTopCheckBox" AutomationProperties.AutomationId="Settings.EditText.TopmostToggle" Click="EditWindowIsOnTopCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Wrap long lines of text instead of scrolling horizontally."
            HeaderText="Enable word wrap"
            Icon="{ui:SymbolIcon TextWrap24}">
            <ui:ToggleSwitch x:Name="EditWindowIsWordWrapOnCheckBox" AutomationProperties.AutomationId="Settings.EditText.WordWrapToggle" Click="EditWindowIsWordWrapOnCheckBox_Click" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Window size and position" />

        <controls:SettingsCard
            Description="A new Edit Text Window opens where and how large the last one was when closed. Turn off to always open centered at the default size below."
            HeaderText="New windows reopen at the last size and position"
            Icon="{ui:SymbolIcon WindowLocationTarget20}">
            <ui:ToggleSwitch x:Name="RestoreEtwPositionsCheckBox" AutomationProperties.AutomationId="Settings.EditText.RestorePositionToggle" Click="RestoreEtwPositionsCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="The size of a new window when it isn't restored to its last size, and the fallback if the last position is no longer on a screen."
            HeaderText="Default window size"
            Icon="{ui:SymbolIcon ArrowAutofitContent24}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <RadioButton
                        x:Name="EtwSizeModePixelsRadio"
                        AutomationProperties.AutomationId="Settings.EditText.DefaultSize.Pixels"
                        Click="EtwSizeModeRadio_Click"
                        Content="Pixels"
                        GroupName="EtwDefaultSizeMode"
                        Tag="Pixels" />
                    <RadioButton
                        x:Name="EtwSizeModePercentRadio"
                        Margin="16,0,0,0"
                        AutomationProperties.AutomationId="Settings.EditText.DefaultSize.Percent"
                        Click="EtwSizeModeRadio_Click"
                        Content="Percent of screen"
                        GroupName="EtwDefaultSizeMode"
                        Tag="Percent" />
                </StackPanel>

                <StackPanel x:Name="EtwPixelSizePanel" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="90"
                            VerticalAlignment="Center"
                            Text="Width (px):" />
                        <ui:NumberBox
                            x:Name="EtwDefaultWidthBox"
                            Width="190"
                            AutomationProperties.AutomationId="Settings.EditText.DefaultWidth"
                            LargeChange="100"
                            Maximum="10000"
                            Minimum="200"
                            SmallChange="10"
                            ValueChanged="EtwDefaultSizeBox_ValueChanged" />
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock
                            Width="90"
                            VerticalAlignment="Center"
                            Text="Height (px):" />
                        <ui:NumberBox
                            x:Name="EtwDefaultHeightBox"
                            Width="190"
                            AutomationProperties.AutomationId="Settings.EditText.DefaultHeight"
                            LargeChange="100"
                            Maximum="10000"
                            Minimum="200"
                            SmallChange="10"
                            ValueChanged="EtwDefaultSizeBox_ValueChanged" />
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    x:Name="EtwPercentSizePanel"
                    Margin="0,8,0,0"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            Width="90"
                            VerticalAlignment="Center"
                            Text="Width (%):" />
                        <ui:NumberBox
                            x:Name="EtwDefaultWidthPercentBox"
                            Width="190"
                            AutomationProperties.AutomationId="Settings.EditText.DefaultWidthPercent"
                            LargeChange="10"
                            Maximum="100"
                            Minimum="10"
                            SmallChange="5"
                            ValueChanged="EtwDefaultSizeBox_ValueChanged" />
                    </StackPanel>
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <TextBlock
                            Width="90"
                            VerticalAlignment="Center"
                            Text="Height (%):" />
                        <ui:NumberBox
                            x:Name="EtwDefaultHeightPercentBox"
                            Width="190"
                            AutomationProperties.AutomationId="Settings.EditText.DefaultHeightPercent"
                            LargeChange="10"
                            Maximum="100"
                            Minimum="10"
                            SmallChange="5"
                            ValueChanged="EtwDefaultSizeBox_ValueChanged" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        Text="Relative to the usable area of the primary screen (excluding the taskbar)."
                        TextWrapping="Wrap" />
                </StackPanel>

                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="Settings.EditText.DefaultSizeReset"
                    Click="EtwDefaultSizeReset_Click"
                    Content="Reset to default (800 × 500 px, 60% × 70%)" />
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsCard
            Description="Where a new window appears on the screen when it isn't restored to its last position. Pick the point it lines up with."
            HeaderText="Default window position"
            Icon="{ui:SymbolIcon Grid24}">
            <UniformGrid
                x:Name="EtwAnchorGrid"
                Columns="3"
                Rows="3"
                AutomationProperties.AutomationId="Settings.EditText.DefaultAnchorGrid">
                <RadioButton Margin="0,0,6,6" AutomationProperties.AutomationId="Settings.EditText.Anchor.TopLeft" AutomationProperties.Name="Top left" Click="EtwAnchorRadio_Click" GroupName="EtwAnchor" Tag="TopLeft" ToolTip="Top left" />
                <RadioButton Margin="0,0,6,6" AutomationProperties.AutomationId="Settings.EditText.Anchor.TopCenter" AutomationProperties.Name="Top center" Click="EtwAnchorRadio_Click" GroupName="EtwAnchor" Tag="TopCenter" ToolTip="Top center" />
                <RadioButton Margin="0,0,0,6" AutomationProperties.AutomationId="Settings.EditText.Anchor.TopRight" AutomationProperties.Name="Top right" Click="EtwAnchorRadio_Click" GroupName="EtwAnchor" Tag="TopRight" ToolTip="Top right" />
                <RadioButton Margin="0,0,6,6" AutomationProperties.AutomationId="Settings.EditText.Anchor.MiddleLeft" AutomationProperties.Name="Middle left" Click="EtwAnchorRadio_Click" GroupName="EtwAnchor" Tag="MiddleLeft" ToolTip="Middle left" />
                <RadioButton Margin="0,0,6,6" AutomationProperties.AutomationId="Settings.EditText.Anchor.MiddleCenter" AutomationProperties.Name="Center" Click="EtwAnchorRadio_Click" GroupName="EtwAnchor" Tag="MiddleCenter" ToolTip="Center" />
                <RadioButton Margin="0,0,0,6" AutomationProperties.AutomationId="Settings.EditText.Anchor.MiddleRight" AutomationProperties.Name="Middle right" Click="EtwAnchorRadio_Click" GroupName="EtwAnchor" Tag="MiddleRight" ToolTip="Middle right" />
                <RadioButton Margin="0,0,6,0" AutomationProperties.AutomationId="Settings.EditText.Anchor.BottomLeft" AutomationProperties.Name="Bottom left" Click="EtwAnchorRadio_Click" GroupName="EtwAnchor" Tag="BottomLeft" ToolTip="Bottom left" />
                <RadioButton Margin="0,0,6,0" AutomationProperties.AutomationId="Settings.EditText.Anchor.BottomCenter" AutomationProperties.Name="Bottom center" Click="EtwAnchorRadio_Click" GroupName="EtwAnchor" Tag="BottomCenter" ToolTip="Bottom center" />
                <RadioButton Margin="0" AutomationProperties.AutomationId="Settings.EditText.Anchor.BottomRight" AutomationProperties.Name="Bottom right" Click="EtwAnchorRadio_Click" GroupName="EtwAnchor" Tag="BottomRight" ToolTip="Bottom right" />
            </UniformGrid>
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="A file opened in the Edit Text Window returns to its last size, position, and maximized state. Maximized windows keep their normal size for Restore Down. Files you haven't opened before use the new window behavior above."
            HeaderText="Reopen files at their own size and position"
            Icon="{ui:SymbolIcon DocumentArrowRight24}">
            <ui:ToggleSwitch x:Name="EtwRememberFilePlacementCheckBox" AutomationProperties.AutomationId="Settings.EditText.RememberFilePlacementToggle" Click="EtwRememberFilePlacementCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="A file opened in the Edit Text Window returns to the layout, editor mode, and code language it was last shown in, instead of the defaults for its file type."
            HeaderText="Reopen files in their last layout and mode"
            Icon="{ui:SymbolIcon DocumentArrowRight24}">
            <ui:ToggleSwitch x:Name="EtwRememberFileViewCheckBox" AutomationProperties.AutomationId="Settings.EditText.RememberFileViewToggle" Click="EtwRememberFileViewCheckBox_Click" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Behavior" />

        <controls:SettingsCard
            Description="Convert Unix (LF) and classic Mac (CR) line endings to Windows (CRLF) when pasting text."
            HeaderText="Normalize to Windows line endings on paste"
            Icon="{ui:SymbolIcon TextParagraph24}">
            <ui:ToggleSwitch x:Name="EtwNormalizeLineEndingsOnPasteCheckBox" AutomationProperties.AutomationId="Settings.EditText.NormalizeLineEndingsToggle" Click="EtwNormalizeLineEndingsOnPasteCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="Control when red squiggles appear under misspelled words in the Edit Text Window."
            HeaderText="Spell check"
            Icon="{ui:SymbolIcon TextGrammarCheckmark24}">
            <StackPanel>
                <RadioButton
                    x:Name="SpellCheckAutoRadio"
                    AutomationProperties.AutomationId="Settings.EditText.SpellCheck.Auto"
                    Click="SpellCheckModeRadio_Click"
                    Content="Auto"
                    GroupName="EtwSpellCheckMode"
                    Tag="Auto" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Turn spell check off automatically for very large documents or content with several long unspaced tokens (GUIDs, app manifests, base64), and on otherwise."
                    TextWrapping="Wrap" />

                <RadioButton
                    x:Name="SpellCheckAlwaysOnRadio"
                    AutomationProperties.AutomationId="Settings.EditText.SpellCheck.AlwaysOn"
                    Click="SpellCheckModeRadio_Click"
                    Content="Always on"
                    GroupName="EtwSpellCheckMode"
                    Tag="AlwaysOn" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Always spell check, regardless of the content."
                    TextWrapping="Wrap" />

                <RadioButton
                    x:Name="SpellCheckOffRadio"
                    AutomationProperties.AutomationId="Settings.EditText.SpellCheck.Off"
                    Click="SpellCheckModeRadio_Click"
                    Content="Off"
                    GroupName="EtwSpellCheckMode"
                    Tag="Off" />
                <TextBlock
                    Margin="24,0,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Never spell check."
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Toolbar and UI" />

        <controls:SettingsCard
            Description="Collapse the bottom bar that contains status text, character info, regex buttons, and the language picker."
            HeaderText="Hide bottom toolbar"
            Icon="{ui:SymbolIcon PanelBottom20}">
            <ui:ToggleSwitch x:Name="EditWindowBottomBarIsHiddenCheckBox" AutomationProperties.AutomationId="Settings.EditText.HideBottomBarToggle" Click="EditWindowBottomBarIsHiddenCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Add an OCR language selector control to the bottom bar."
            HeaderText="Show language picker in toolbar"
            Icon="{ui:SymbolIcon LocalLanguage24}">
            <ui:ToggleSwitch x:Name="EtwShowLangPickerCheckBox" AutomationProperties.AutomationId="Settings.EditText.ShowLanguagePickerToggle" Click="EtwShowLangPickerCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Add responsive horizontal padding to the text area (50–160px depending on window width) to improve readability on wider windows."
            HeaderText="Show text margins"
            Icon="{ui:SymbolIcon AutoFitWidth24}">
            <ui:ToggleSwitch x:Name="EtwUseMarginsCheckBox" AutomationProperties.AutomationId="Settings.EditText.UseMarginsToggle" Click="EtwUseMarginsCheckBox_Click" />
        </controls:SettingsCard>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Text" />

        <controls:SettingsExpander
            Description="Default font used when opening a new Edit Text Window."
            HeaderText="Default font"
            Icon="{ui:SymbolIcon TextFont24}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        VerticalAlignment="Center"
                        Text="Font family:" />
                    <TextBox
                        x:Name="FontFamilyTextBox"
                        AutomationProperties.AutomationId="Settings.EditText.FontFamily"
                        Width="200"
                        Margin="12,0,0,0"
                        LostFocus="FontFamilyTextBox_LostFocus" />
                </StackPanel>

                <StackPanel
                    Margin="0,8,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <TextBlock
                        Width="90"
                        VerticalAlignment="Center"
                        Text="Font size:" />
                    <Slider
                        x:Name="FontSizeSlider"
                        AutomationProperties.AutomationId="Settings.EditText.FontSize"
                        Width="200"
                        Margin="12,0,0,0"
                        IsSnapToTickEnabled="True"
                        Maximum="72"
                        Minimum="8"
                        SmallChange="1"
                        TickFrequency="1"
                        ValueChanged="FontSizeSlider_ValueChanged" />
                    <TextBlock
                        x:Name="FontSizeValueText"
                        Width="36"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                    <CheckBox
                        x:Name="IsFontBoldCheckBox"
                        Click="IsFontBoldCheckBox_Click"
                        Content="Bold" />
                    <CheckBox
                        x:Name="IsFontItalicCheckBox"
                        Margin="16,0,0,0"
                        Click="IsFontItalicCheckBox_Click"
                        Content="Italic" />
                    <CheckBox
                        x:Name="IsFontUnderlineCheckBox"
                        Margin="16,0,0,0"
                        Click="IsFontUnderlineCheckBox_Click"
                        Content="Underline" />
                    <CheckBox
                        x:Name="IsFontStrikeoutCheckBox"
                        Margin="16,0,0,0"
                        Click="IsFontStrikeoutCheckBox_Click"
                        Content="Strikeout" />
                </StackPanel>
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsExpander
            Description="Choose which details appear as clickable buttons in the Edit Text Window status bar."
            HeaderText="Status bar details"
            Icon="{ui:SymbolIcon AppsListDetail24}">
            <StackPanel>
                <CheckBox
                    x:Name="EtwShowWordCountCheckBox"
                    Click="EtwShowWordCountCheckBox_Click"
                    Content="Show word count" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Adds word count alongside the cursor line and column in the status bar (e.g. &quot;Wrds 42, Ln 3, Col 7&quot;)."
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="EtwShowCharDetailsCheckBox"
                    Click="EtwShowCharDetailsCheckBox_Click"
                    Content="Show character details" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="For a single selected character, shows its Unicode code point (e.g. U+0041). For a longer selection, shows the character count."
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="EtwShowMatchCountCheckBox"
                    Click="EtwShowMatchCountCheckBox_Click"
                    Content="Show exact match count" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Searches the full text for exact copies of the current selection. Click the count to open Find and Replace."
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="EtwShowRegexPatternCheckBox"
                    Click="EtwShowRegexPatternCheckBox_Click"
                    Content="Show generated regex pattern" />
                <TextBlock
                    Margin="24,0,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Displays a regex pattern derived from the current selection. Scroll the mouse wheel over the button to adjust match precision."
                    TextWrapping="Wrap" />

                <CheckBox
                    x:Name="EtwShowSimilarMatchesCheckBox"
                    Click="EtwShowSimilarMatchesCheckBox_Click"
                    Content="Show similar text matches" />
                <TextBlock
                    Margin="24,0,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Counts other text that matches the same character-class pattern as the selection. Scroll the mouse wheel over the button to adjust match precision."
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Calculator" />

        <controls:SettingsCard
            Description="Show a right-side panel that evaluates math expressions as you type them in the editor."
            HeaderText="Show calculator pane"
            Icon="{ui:SymbolIcon Calculator24}">
            <ui:ToggleSwitch x:Name="CalcShowPaneCheckBox" AutomationProperties.AutomationId="Settings.EditText.CalculatorPaneToggle" Click="CalcShowPaneCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Display expression evaluation errors inline in the calculator pane."
            HeaderText="Show calculator errors"
            Icon="{ui:SymbolIcon ErrorCircle24}">
            <ui:ToggleSwitch x:Name="CalcShowErrorsCheckBox" AutomationProperties.AutomationId="Settings.EditText.CalculatorErrorsToggle" Click="CalcShowErrorsCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsCard
            Description="Lay out the editor and the calculator pane with the new pane host. Turn this off to go back to the previous editor area. Applies to Edit Text windows opened after the change."
            HeaderText="Use the new pane layout"
            Icon="{ui:SymbolIcon PanelRight24}">
            <ui:ToggleSwitch x:Name="EtwPaneLayoutToggle" AutomationProperties.AutomationId="Settings.EditText.PaneLayoutToggle" Click="EtwPaneLayoutToggle_Click" />
        </controls:SettingsCard>

    </StackPanel>
</Page>

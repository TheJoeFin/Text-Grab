<Page
    x:Class="Text_Grab.Pages.QuickLookupSettings"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="QuickLookupSettings"
    AutomationProperties.AutomationId="Settings.QuickLookupPage"
    d:DesignHeight="500"
    d:DesignWidth="800"
    Loaded="Page_Loaded"
    mc:Ignorable="d">

    <StackPanel Margin="20,12,24,40" Orientation="Vertical">
        <TextBlock Style="{StaticResource SettingsPageTitle}" Text="Quick Simple Lookup Settings" />

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Lookup file" />

        <controls:SettingsExpander
            Description="Path to a CSV file with ShortValue and LongValue columns. Leave empty to use a default cache file stored alongside the app."
            HeaderText="Lookup file location"
            Icon="{ui:SymbolIcon DocumentTable24}"
            IsExpanded="True">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="LookupFileLocationTextBox"
                    AutomationProperties.AutomationId="Settings.QuickLookup.FileLocation"
                    HorizontalAlignment="Stretch"
                    LostFocus="LookupFileLocationTextBox_LostFocus" />
                <Button
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    Click="BrowseLookupFileButton_Click"
                    Content="Browse..."
                    AutomationProperties.AutomationId="Settings.QuickLookup.BrowseFileButton" />
            </Grid>
        </controls:SettingsExpander>

        <TextBlock Style="{StaticResource SettingsSectionHeader}" Text="Behavior" />

        <controls:SettingsCard
            Description="Window is a normal window. Popup has no title bar, stays out of the taskbar and Alt+Tab, and closes when it loses focus (like a command palette). Applies the next time Quick Lookup opens."
            HeaderText="Style"
            Icon="{ui:SymbolIcon WindowApps24}">
            <ComboBox
                x:Name="LookupStyleComboBox"
                Width="160"
                AutomationProperties.AutomationId="Settings.QuickLookup.Style"
                SelectionChanged="LookupStyleComboBox_SelectionChanged">
                <ComboBoxItem Content="Window" Tag="Window" />
                <ComboBoxItem Content="Popup" Tag="Popup" />
            </ComboBox>
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="Choose which data Quick Lookup shows. This is also available from the filter button next to the search box."
            HeaderText="Data shown in lookup grid"
            Icon="{ui:SymbolIcon Filter24}"
            IsExpanded="True">
            <StackPanel x:Name="LookupSourcesPanel">
                <CheckBox
                    AutomationProperties.AutomationId="Settings.QuickLookup.Source.Data"
                    Click="LookupSourceCheckBox_Click"
                    Content="Lookup data"
                    Tag="Data" />
                <CheckBox
                    AutomationProperties.AutomationId="Settings.QuickLookup.Source.EditHistory"
                    Click="LookupSourceCheckBox_Click"
                    Content="Edit Text Window history"
                    Tag="EditHistory" />
                <CheckBox
                    AutomationProperties.AutomationId="Settings.QuickLookup.Source.GrabHistory"
                    Click="LookupSourceCheckBox_Click"
                    Content="Grab Frame history"
                    Tag="GrabHistory" />
                <CheckBox
                    AutomationProperties.AutomationId="Settings.QuickLookup.Source.PdfHistory"
                    Click="LookupSourceCheckBox_Click"
                    Content="PDF history"
                    Tag="PdfHistory" />
                <CheckBox
                    AutomationProperties.AutomationId="Settings.QuickLookup.Source.GrabTemplates"
                    Click="LookupSourceCheckBox_Click"
                    Content="Grab Templates"
                    Tag="GrabTemplates" />
            </StackPanel>
        </controls:SettingsExpander>

        <controls:SettingsCard
            Description="Automatically save the lookup data file whenever rows are added, edited, deleted, or imported."
            HeaderText="Auto save lookup data"
            Icon="{ui:SymbolIcon Save24}">
            <ui:ToggleSwitch x:Name="LookupAutoSaveCheckBox" AutomationProperties.AutomationId="Settings.QuickLookup.AutoSaveToggle" Click="LookupAutoSaveCheckBox_Click" />
        </controls:SettingsCard>

        <controls:SettingsExpander
            Description="After pressing Enter to select, close Quick Lookup and paste into the previously focused app."
            HeaderText="Paste selected value into the previously focused app"
            Icon="{ui:SymbolIcon ClipboardPaste24}">
            <controls:SettingsExpander.SettingsContent>
                <ui:ToggleSwitch x:Name="TryInsertCheckBox" AutomationProperties.AutomationId="Settings.QuickLookup.InsertToggle" Click="TryInsertCheckBox_Click" />
            </controls:SettingsExpander.SettingsContent>
            <StackPanel>
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="Insert delay (seconds):" />
                    <Slider
                        x:Name="InsertDelaySlider"
                        AutomationProperties.AutomationId="Settings.QuickLookup.InsertDelay"
                        Width="200"
                        Margin="12,0,0,0"
                        IsSnapToTickEnabled="True"
                        Maximum="5"
                        Minimum="0"
                        SmallChange="0.1"
                        TickFrequency="0.1"
                        ValueChanged="InsertDelaySlider_ValueChanged" />
                    <TextBlock
                        x:Name="InsertDelayValueText"
                        AutomationProperties.AutomationId="Settings.QuickLookup.InsertDelayValue"
                        Width="40"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock
                    Margin="0,4,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Quick Lookup sends Ctrl+V to the previously focused app after this delay — giving you time to switch windows."
                    TextWrapping="Wrap" />
            </StackPanel>
        </controls:SettingsExpander>

    </StackPanel>
</Page>

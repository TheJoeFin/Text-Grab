<ui:FluentWindow
    x:Class="Text_Grab.FirstRunWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Welcome to Text Grab"
    Width="1120"
    Height="820"
    MinWidth="760"
    MinHeight="620"
    Padding="0"
    AutomationProperties.AutomationId="FirstRunWindow"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Closed="Window_Closed"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Loaded="FirstRun_Loaded"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Window.Resources>
        <ui:ImageIcon x:Key="TextGrabIcon" Source="/Text-Grab;component/Images/TealSelect40.png" />

        <!--  Brand teal, used for accents that read on both light and dark themes  -->
        <SolidColorBrush x:Key="BrandTealBrush" Color="#308E98" />
        <SolidColorBrush x:Key="BrandTealSubtleBrush" Color="#24308E98" />
        <SolidColorBrush x:Key="BrandTealSubtleStrokeBrush" Color="#59308E98" />
        <SolidColorBrush x:Key="BrandTealSelectedFillBrush" Color="#16308E98" />
        <SolidColorBrush x:Key="BrandTealButtonBrush" Color="#1F6F78" />
        <SolidColorBrush x:Key="BrandTealButtonHoverBrush" Color="#25808A" />
        <SolidColorBrush x:Key="BrandTealButtonPressedBrush" Color="#1A5E66" />

        <!--  Type ramp  -->
        <Style x:Key="HeroTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="HeroSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ItemTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BodyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="LineHeight" Value="20" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CaptionText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="LineHeight" Value="16" />
            <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  Surfaces  -->
        <Style x:Key="SurfaceCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="IconTile" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource BrandTealSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandTealSubtleStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <Style x:Key="IconTileSymbol" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource BrandTealBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StepBadge" TargetType="Border">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Background" Value="{StaticResource BrandTealSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BrandTealSubtleStrokeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>

        <Style x:Key="StepBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="SectionHeader" TargetType="Grid">
            <Setter Property="Margin" Value="0,40,0,16" />
        </Style>

        <Style x:Key="PreviewFrame" TargetType="Border">
            <Setter Property="Height" Value="184" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        </Style>

        <Style x:Key="SettingRow" TargetType="Border">
            <Setter Property="MinHeight" Value="72" />
            <Setter Property="Padding" Value="20,14" />
        </Style>

        <Style x:Key="RowDivider" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
        </Style>

        <!--  Focus visuals  -->
        <Style x:Key="CardFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle
                            Margin="-3"
                            RadiusX="11"
                            RadiusY="11"
                            SnapsToDevicePixels="True"
                            Stroke="{DynamicResource FocusStrokeColorOuterBrush}"
                            StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ButtonFocusVisual">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Rectangle
                            Margin="-3"
                            RadiusX="7"
                            RadiusY="7"
                            SnapsToDevicePixels="True"
                            Stroke="{DynamicResource FocusStrokeColorOuterBrush}"
                            StrokeThickness="2" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Buttons  -->
        <Style x:Key="WelcomeSecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style
            x:Key="TryModeButton"
            BasedOn="{StaticResource WelcomeSecondaryButton}"
            TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,20,20" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <Style x:Key="WelcomePrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource BrandTealButtonBrush}" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandTealButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{StaticResource BrandTealButtonPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ResourceLinkButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource ButtonFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border
                            x:Name="border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  A whole card that acts as one radio button in the default-launch group  -->
        <Style x:Key="ModeCardRadio" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="20" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource CardFocusVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Grid>
                            <Border
                                x:Name="CardBackground"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" />
                            <Border
                                x:Name="SelectedFill"
                                Background="{StaticResource BrandTealSelectedFillBrush}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border
                                x:Name="SelectedRing"
                                BorderBrush="{StaticResource BrandTealBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                Opacity="0" />
                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                RecognizesAccessKey="False" />
                            <Grid
                                Height="40"
                                Margin="0,20,20,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Top">
                                <Ellipse
                                    x:Name="UncheckedRing"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}"
                                    StrokeThickness="1.5" />
                                <Border
                                    x:Name="DefaultPill"
                                    Height="24"
                                    Padding="8,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource BrandTealButtonBrush}"
                                    CornerRadius="12"
                                    Visibility="Collapsed">
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <ui:SymbolIcon
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="White"
                                            Symbol="Checkmark12" />
                                        <TextBlock
                                            Margin="4,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="Default" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBackground" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                <Setter TargetName="UncheckedRing" Property="Stroke" Value="{StaticResource BrandTealBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectedFill" Property="Opacity" Value="1" />
                                <Setter TargetName="SelectedRing" Property="Opacity" Value="1" />
                                <Setter TargetName="UncheckedRing" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="DefaultPill" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Title="Welcome to Text Grab"
            Height="36"
            Margin="2,2,2,0"
            Padding="10,2"
            Icon="{StaticResource TextGrabIcon}" />

        <ScrollViewer
            Grid.Row="1"
            HorizontalScrollBarVisibility="Disabled"
            VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="1040" Margin="40,20,40,40">

                <!--  Hero  -->
                <Border
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid>
                        <Border CornerRadius="11">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,1" EndPoint="1,0">
                                    <GradientStop Offset="0" Color="#00308E98" />
                                    <GradientStop Offset="0.45" Color="#0A308E98" />
                                    <GradientStop Offset="1" Color="#3D308E98" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <Grid Margin="40,36,40,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel VerticalAlignment="Center">
                                <Border
                                    Padding="10,3"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource BrandTealSubtleBrush}"
                                    BorderBrush="{StaticResource BrandTealSubtleStrokeBrush}"
                                    BorderThickness="1"
                                    CornerRadius="11">
                                    <TextBlock
                                        x:Name="VersionTextBlock"
                                        AutomationProperties.AutomationId="FirstRun.Version"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                        Text="Version" />
                                </Border>

                                <TextBlock
                                    Margin="0,14,0,0"
                                    Style="{StaticResource HeroTitle}"
                                    Text="Welcome to Text Grab" />

                                <TextBlock
                                    MaxWidth="560"
                                    Margin="0,10,0,0"
                                    HorizontalAlignment="Left"
                                    Style="{StaticResource HeroSubtitle}"
                                    Text="Grab text from anywhere on screen, launch the mode that fits the moment, and keep the app ready exactly how you like it." />
                            </StackPanel>

                            <Image
                                Grid.Column="1"
                                Width="112"
                                Height="112"
                                Margin="32,0,8,0"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Text Grab logo"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="/Text-Grab;component/Images/Text-Grab-Icon.png">
                                <Image.Effect>
                                    <DropShadowEffect
                                        BlurRadius="36"
                                        Direction="270"
                                        Opacity="0.4"
                                        ShadowDepth="10"
                                        Color="#0B2F33" />
                                </Image.Effect>
                            </Image>

                            <Border
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,28,0,0"
                                Style="{StaticResource RowDivider}" />

                            <Grid
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                Margin="0,24,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <ui:SymbolIcon Style="{StaticResource IconTileSymbol}" Symbol="Flash24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Style="{StaticResource ItemTitle}" Text="Built for speed" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource CaptionText}"
                                            Text="Capture text, send it to the clipboard, and move on without fighting a heavy interface." />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <ui:SymbolIcon Style="{StaticResource IconTileSymbol}" Symbol="ShieldTask24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Style="{StaticResource ItemTitle}" Text="Private by design" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource CaptionText}"
                                            Text="Built on the OCR engine in Windows, so your captured text stays on your device." />
                                    </StackPanel>
                                </Grid>

                                <Grid Grid.Column="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <ui:SymbolIcon Style="{StaticResource IconTileSymbol}" Symbol="WindowApps24" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                        <TextBlock Style="{StaticResource ItemTitle}" Text="Fits into Windows" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            Style="{StaticResource CaptionText}"
                                            Text="Jump lists, the clipboard manager, startup, and background hotkeys all work together." />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Step 1: default mode  -->
                <Grid Style="{StaticResource SectionHeader}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StepBadge}">
                        <TextBlock Style="{StaticResource StepBadgeText}" Text="1" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Choose your default mode" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SectionSubtitle}"
                            Text="Each mode is built for a different kind of text work. Select the one Text Grab should open by default, and try any of them right now." />
                    </StackPanel>
                </Grid>

                <Grid Grid.IsSharedSizeScope="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Full Screen  -->
                    <Grid>
                        <RadioButton
                            x:Name="FullScreenRDBTN"
                            AutomationProperties.AutomationId="FirstRun.DefaultFullscreenRadio"
                            AutomationProperties.HelpText="Use Full Screen as the default launch mode"
                            AutomationProperties.Name="Full Screen"
                            Checked="RadioButton_Checked"
                            GroupName="DefaultLaunch"
                            Style="{StaticResource ModeCardRadio}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="ModeHeader" />
                                    <RowDefinition Height="Auto" SharedSizeGroup="ModeDescription" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,96,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <ui:SymbolIcon Style="{StaticResource IconTileSymbol}" Symbol="SlideAdd24" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardTitle}"
                                        Text="Full Screen" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource BodyText}"
                                    Text="Like a screenshot tool for text. Draw once, copy fast, and send the result straight to the clipboard." />
                                <Border
                                    Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource PreviewFrame}">
                                    <Border.Background>
                                        <ImageBrush
                                            AlignmentY="Top"
                                            ImageSource="/Text-Grab;component/Images/FSG.png"
                                            Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Grid
                                    Grid.Row="3"
                                    MinHeight="32"
                                    Margin="0,16,0,0"
                                    VerticalAlignment="Bottom">
                                    <TextBlock
                                        Margin="0,0,156,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionText}"
                                        Text="Best for quick one-off captures anywhere on screen." />
                                </Grid>
                            </Grid>
                        </RadioButton>
                        <Button
                            x:Name="TryFullscreen"
                            AutomationProperties.AutomationId="FirstRun.PreviewFullscreenButton"
                            Click="TryFullscreen_Click"
                            Style="{StaticResource TryModeButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="14"
                                    Symbol="Play24" />
                                <TextBlock Text="Try Full Screen" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Grab Frame  -->
                    <Grid Grid.Column="2">
                        <RadioButton
                            x:Name="GrabFrameRDBTN"
                            AutomationProperties.AutomationId="FirstRun.DefaultGrabFrameRadio"
                            AutomationProperties.HelpText="Use Grab Frame as the default launch mode"
                            AutomationProperties.Name="Grab Frame"
                            Checked="RadioButton_Checked"
                            GroupName="DefaultLaunch"
                            Style="{StaticResource ModeCardRadio}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="ModeHeader" />
                                    <RowDefinition Height="Auto" SharedSizeGroup="ModeDescription" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,96,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <ui:SymbolIcon Style="{StaticResource IconTileSymbol}" Symbol="PanelBottom20" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardTitle}"
                                        Text="Grab Frame" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource BodyText}"
                                    Text="Keep an OCR frame floating on top, inspect text in place, and work with images or PDFs without leaving the app." />
                                <Border
                                    Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource PreviewFrame}">
                                    <Border.Background>
                                        <ImageBrush
                                            AlignmentY="Top"
                                            ImageSource="/Text-Grab;component/Images/GF.png"
                                            Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Grid
                                    Grid.Row="3"
                                    MinHeight="32"
                                    Margin="0,16,0,0"
                                    VerticalAlignment="Bottom">
                                    <TextBlock
                                        Margin="0,0,156,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionText}"
                                        Text="Best for repeated grabs, overlays, PDFs, and tighter control." />
                                </Grid>
                            </Grid>
                        </RadioButton>
                        <Button
                            x:Name="TryGrabFrame"
                            AutomationProperties.AutomationId="FirstRun.PreviewGrabFrameButton"
                            Click="TryGrabFrame_Click"
                            Style="{StaticResource TryModeButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="14"
                                    Symbol="Play24" />
                                <TextBlock Text="Try Grab Frame" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Edit Text  -->
                    <Grid Grid.Row="2">
                        <RadioButton
                            x:Name="EditWindowRDBTN"
                            AutomationProperties.AutomationId="FirstRun.DefaultEditTextRadio"
                            AutomationProperties.HelpText="Use the Edit Text Window as the default launch mode"
                            AutomationProperties.Name="Edit Text Window"
                            Checked="RadioButton_Checked"
                            GroupName="DefaultLaunch"
                            Style="{StaticResource ModeCardRadio}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="ModeHeader" />
                                    <RowDefinition Height="Auto" SharedSizeGroup="ModeDescription" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,96,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <ui:SymbolIcon Style="{StaticResource IconTileSymbol}" Symbol="Window24" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardTitle}"
                                        Text="Edit Text Window" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource BodyText}"
                                    Text="Clean up OCR results in a focused plain-text workspace with tools for casing, trimming, regex, and fast corrections." />
                                <Border
                                    Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource PreviewFrame}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/Text-Grab;component/Images/ETW.png" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Grid
                                    Grid.Row="3"
                                    MinHeight="32"
                                    Margin="0,16,0,0"
                                    VerticalAlignment="Bottom">
                                    <TextBlock
                                        Margin="0,0,156,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionText}"
                                        Text="Best for OCR plus lightweight cleanup in one place." />
                                </Grid>
                            </Grid>
                        </RadioButton>
                        <Button
                            x:Name="TryEditWindow"
                            AutomationProperties.AutomationId="FirstRun.PreviewEditTextButton"
                            Click="TryEditWindow_Click"
                            Style="{StaticResource TryModeButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="14"
                                    Symbol="Play24" />
                                <TextBlock Text="Try Edit Text" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!--  Quick Simple Lookup  -->
                    <Grid Grid.Row="2" Grid.Column="2">
                        <RadioButton
                            x:Name="QuickLookupRDBTN"
                            AutomationProperties.AutomationId="FirstRun.DefaultQuickLookupRadio"
                            AutomationProperties.HelpText="Use Quick Simple Lookup as the default launch mode"
                            AutomationProperties.Name="Quick Simple Lookup"
                            Checked="RadioButton_Checked"
                            GroupName="DefaultLaunch"
                            Style="{StaticResource ModeCardRadio}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" SharedSizeGroup="ModeHeader" />
                                    <RowDefinition Height="Auto" SharedSizeGroup="ModeDescription" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,96,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource IconTile}">
                                        <ui:SymbolIcon Style="{StaticResource IconTileSymbol}" Symbol="SlideSearch24" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CardTitle}"
                                        Text="Quick Simple Lookup" />
                                </Grid>
                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,12,0,0"
                                    Style="{StaticResource BodyText}"
                                    Text="Store your own reusable snippets, search them instantly, and copy the right text without doing a new OCR pass." />
                                <Border
                                    Grid.Row="2"
                                    Margin="0,16,0,0"
                                    Style="{StaticResource PreviewFrame}">
                                    <Border.Background>
                                        <ImageBrush ImageSource="/Text-Grab;component/Images/QSL.png" Stretch="UniformToFill" />
                                    </Border.Background>
                                </Border>
                                <Grid
                                    Grid.Row="3"
                                    MinHeight="32"
                                    Margin="0,16,0,0"
                                    VerticalAlignment="Bottom">
                                    <TextBlock
                                        Margin="0,0,156,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource CaptionText}"
                                        Text="Best for personal snippets, templates, and quick copying." />
                                </Grid>
                            </Grid>
                        </RadioButton>
                        <Button
                            x:Name="TryQuickLookup"
                            AutomationProperties.AutomationId="FirstRun.PreviewQuickLookupButton"
                            Click="TryQuickLookup_Click"
                            Style="{StaticResource TryModeButton}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon
                                    Margin="0,0,6,0"
                                    FontSize="14"
                                    Symbol="Play24" />
                                <TextBlock Text="Try Quick Lookup" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Grid>

                <!--  Step 2: keep it ready  -->
                <Grid Style="{StaticResource SectionHeader}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StepBadge}">
                        <TextBlock Style="{StaticResource StepBadgeText}" Text="2" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Keep Text Grab ready" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SectionSubtitle}"
                            Text="These are the settings most people change first. Everything else stays available in Settings." />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SurfaceCard}">
                    <StackPanel>
                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center">
                                    <ui:SymbolIcon Style="{StaticResource IconTileSymbol}" Symbol="Alert24" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="16,0,24,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ItemTitle}" Text="Notifications" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource CaptionText}"
                                        Text="Open copied text in an Edit Text Window straight from the toast notification." />
                                </StackPanel>
                                <ui:ToggleSwitch
                                    x:Name="NotificationsCheckBox"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="FirstRun.NotificationsToggle"
                                    AutomationProperties.Name="Enable notifications"
                                    Checked="NotificationsCheckBox_Checked"
                                    OffContent="Off"
                                    OnContent="On"
                                    Unchecked="NotificationsCheckBox_Checked" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowDivider}" />

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center">
                                    <ui:SymbolIcon Style="{StaticResource IconTileSymbol}" Symbol="Keyboard24" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="16,0,24,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ItemTitle}" Text="Run in the background" />
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource CaptionText}"
                                        Text="Keep Text Grab running so hotkeys and faster relaunch are ready when you need them." />
                                </StackPanel>
                                <ui:ToggleSwitch
                                    x:Name="BackgroundCheckBox"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="FirstRun.BackgroundToggle"
                                    AutomationProperties.Name="Run Text Grab in the background"
                                    OffContent="Off"
                                    OnContent="On" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource RowDivider}" />

                        <Border Style="{StaticResource SettingRow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource IconTile}" VerticalAlignment="Center">
                                    <ui:SymbolIcon Style="{StaticResource IconTileSymbol}" Symbol="Rocket24" />
                                </Border>
                                <StackPanel
                                    Grid.Column="1"
                                    Margin="16,0,24,0"
                                    VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource ItemTitle}" Text="Start with Windows" />
                                    <TextBlock
                                        x:Name="StartupTextblock"
                                        Margin="0,2,0,0"
                                        AutomationProperties.AutomationId="FirstRun.StartupStatus"
                                        Style="{StaticResource CaptionText}"
                                        Text="Launch Text Grab when you sign in so your preferred mode is always close at hand." />
                                </StackPanel>
                                <ui:ToggleSwitch
                                    x:Name="StartupCheckbox"
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="FirstRun.StartupToggle"
                                    AutomationProperties.Name="Start Text Grab with Windows"
                                    Checked="StartupCheckbox_Checked"
                                    OffContent="Off"
                                    OnContent="On"
                                    Unchecked="StartupCheckbox_Checked" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Learn more  -->
                <Grid Style="{StaticResource SectionHeader}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource StepBadge}">
                        <ui:SymbolIcon
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Symbol="BookOpen24" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Learn more" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SectionSubtitle}"
                            Text="A deeper look at each mode, plus where to get help." />
                    </StackPanel>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="2*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel>
                        <Expander Header="How Full Screen works">
                            <TextBlock Style="{StaticResource BodyText}">
                                Draw around the text you want or click a single word. Text Grab reads the selection with Windows OCR, copies the result to the clipboard, and lets you paste it anywhere. If nothing is recognized, you can immediately try again.
                            </TextBlock>
                        </Expander>

                        <Expander Margin="0,4,0,0" Header="How Grab Frame works">
                            <TextBlock Style="{StaticResource BodyText}">
                                Grab Frame stays on top, can be moved or resized, and reads text inside its border. You can select word borders, read everything in-frame, drop in images or PDFs, zoom in, and switch to table-oriented workflows.
                            </TextBlock>
                        </Expander>

                        <Expander Margin="0,4,0,0" Header="What the Edit Text Window can do">
                            <TextBlock Style="{StaticResource BodyText}">
                                Edit Text is a plain-text workspace for fixing OCR output. It includes tools for trimming spaces, changing case, isolating selections, replacing reserved characters, running find and replace, and extracting regex matches.
                            </TextBlock>
                        </Expander>

                        <Expander Margin="0,4,0,0" Header="Where Quick Simple Lookup fits in">
                            <TextBlock Style="{StaticResource BodyText}">
                                Quick Simple Lookup is the non-OCR companion mode. Store reusable text items, search them instantly, hit Enter to copy, and paste the result wherever you need it.
                            </TextBlock>
                        </Expander>
                    </StackPanel>

                    <Border
                        Grid.Column="2"
                        Padding="8"
                        VerticalAlignment="Top"
                        Style="{StaticResource SurfaceCard}">
                        <StackPanel>
                            <TextBlock
                                Margin="12,8,12,6"
                                Style="{StaticResource ItemTitle}"
                                Text="Help and feedback" />

                            <Button
                                AutomationProperties.AutomationId="FirstRun.GitHubLink"
                                Click="ExternalLink_Click"
                                Style="{StaticResource ResourceLinkButton}"
                                Tag="https://github.com/TheJoeFin/Text-Grab/">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Symbol="Code24" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,8,0"
                                        VerticalAlignment="Center"
                                        Text="Visit the GitHub project"
                                        TextWrapping="Wrap" />
                                    <ui:SymbolIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="Open16" />
                                </Grid>
                            </Button>

                            <Button
                                AutomationProperties.AutomationId="FirstRun.SupportEmailLink"
                                Click="ExternalLink_Click"
                                Style="{StaticResource ResourceLinkButton}"
                                Tag="mailto:support@textgrab.net">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Symbol="Mail24" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,8,0"
                                        VerticalAlignment="Center"
                                        Text="Email support@TextGrab.net"
                                        TextWrapping="Wrap" />
                                    <ui:SymbolIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="Open16" />
                                </Grid>
                            </Button>

                            <Button
                                x:Name="LicensesButton"
                                AutomationProperties.AutomationId="FirstRun.LicensesButton"
                                Click="LicensesButton_Click"
                                Style="{StaticResource ResourceLinkButton}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon
                                        VerticalAlignment="Center"
                                        FontSize="18"
                                        Symbol="DocumentText24" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="12,0,8,0"
                                        VerticalAlignment="Center"
                                        Text="Third-party licenses"
                                        TextWrapping="Wrap" />
                                    <ui:SymbolIcon
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        FontSize="14"
                                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                        Symbol="ChevronRight16" />
                                </Grid>
                            </Button>

                            <Border Margin="12,8,12,0" Style="{StaticResource RowDivider}" />

                            <TextBlock
                                Margin="12,12,12,8"
                                Style="{StaticResource CaptionText}"
                                Text="Reopen this page anytime from Settings or Help, then About." />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!--  Footer: always-visible actions  -->
        <Border
            Grid.Row="2"
            Background="{DynamicResource LayerFillColorDefaultBrush}"
            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid MaxWidth="1040" Margin="40,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Margin="0,0,24,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource CaptionText}"
                    Text="Your choices are saved as you go. You can change them anytime in Settings." />

                <Button
                    x:Name="SettingsButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="FirstRun.OpenSettingsButton"
                    Click="SettingsButton_Click"
                    Style="{StaticResource WelcomeSecondaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Margin="0,0,8,0"
                            FontSize="16"
                            Symbol="Settings24" />
                        <TextBlock Text="Open Settings" />
                    </StackPanel>
                </Button>

                <Button
                    x:Name="OkayButton"
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    AutomationProperties.AutomationId="FirstRun.StartButton"
                    Click="OkayButton_Click"
                    Style="{StaticResource WelcomePrimaryButton}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="StartButtonText" Text="Start Text Grab" />
                        <ui:SymbolIcon
                            Margin="8,0,0,0"
                            FontSize="16"
                            Foreground="White"
                            Symbol="ArrowRight20" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>

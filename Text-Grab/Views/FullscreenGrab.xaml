<Window
    x:Class="Text_Grab.Views.FullscreenGrab"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:wpfui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Text Grab"
    AutomationProperties.AutomationId="FullscreenGrabWindow"
    Width="800"
    Height="450"
    AllowsTransparency="True"
    Background="Transparent"
    Closing="Window_Closing"
    Loaded="Window_Loaded"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    SizeChanged="Window_SizeChanged"
    Topmost="False"
    Unloaded="Window_Unloaded"
    WindowStyle="None"
    mc:Ignorable="d">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Styles/SelectionStyleComboBoxItemStyle.xaml" />
                <ResourceDictionary Source="/Styles/SelectionStyleComboBoxStyle.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--  Numbered "pick an instance" badges for Find on Screen. Own template so the implicit WPF-UI button padding can't squeeze the digits.  -->
            <Style x:Key="FindOnScreenMarkerButtonStyle" TargetType="Button">
                <Setter Property="Height" Value="26" />
                <Setter Property="MinWidth" Value="26" />
                <Setter Property="Padding" Value="6,0" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Foreground" Value="Black" />
                <Setter Property="BorderBrush" Value="Black" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="border"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="False" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="White" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="border" Property="Opacity" Value="0.75" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  Find on Screen "Enter" keycap. Clicking it runs the same action as pressing Enter.  -->
            <!--  Not focusable so clicking it leaves keyboard focus (and Enter) in the search box.  -->
            <Style x:Key="FindOnScreenEnterKeyButtonStyle" TargetType="Button">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="BorderThickness" Value="1,1,1,2" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="key"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RecognizesAccessKey="False" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="key" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    <Setter TargetName="key" Property="BorderBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                </Trigger>
                                <!--  Pressed: key drops 1px and its thick bottom edge flattens, like a real keypress.  -->
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="key" Property="Background" Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                                    <Setter TargetName="key" Property="BorderThickness" Value="1" />
                                    <Setter TargetName="key" Property="Margin" Value="0,1,0,0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid d:Background="NavajoWhite">
        <Image x:Name="BackgroundImage" AutomationProperties.AutomationId="FullscreenGrab.BackgroundImage" Stretch="UniformToFill" />
        <Canvas
            Name="RegionClickCanvas"
            AutomationProperties.AutomationId="FullscreenGrab.SelectionCanvas"
            AutomationProperties.Name="Capture selection surface"
            ContextMenuOpening="RegionClickCanvas_ContextMenuOpening"
            Cursor="Cross"
            MouseDown="RegionClickCanvas_MouseDown"
            MouseEnter="RegionClickCanvas_MouseEnter"
            MouseLeave="RegionClickCanvas_MouseLeave"
            MouseMove="RegionClickCanvas_MouseMove"
            MouseUp="RegionClickCanvas_MouseUp"
            PreviewMouseWheel="RegionClickCanvas_PreviewMouseWheel">
            <Canvas.Clip>
                <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                        <RectangleGeometry x:Name="FullWindow" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                        <RectangleGeometry x:Name="clippingGeometry" />
                    </CombinedGeometry.Geometry2>
                </CombinedGeometry>
            </Canvas.Clip>
            <Canvas.Background>
                <SolidColorBrush
                    x:Name="BackgroundBrush"
                    Opacity="0"
                    Color="{wpfui:ThemeResource ApplicationBackgroundColor}" />
            </Canvas.Background>
            <Canvas.ContextMenu>
                <ContextMenu>
                    <MenuItem
                        Name="SingleLineMenuItem"
                        AutomationProperties.AutomationId="FullscreenGrab.Menu.SingleLine"
                        Click="SingleLineMenuItem_Click"
                        Header="Make Result Text Single Line"
                        IsCheckable="True" />
                    <MenuItem
                        Name="TableMenuItem"
                        AutomationProperties.AutomationId="FullscreenGrab.Menu.Table"
                        Click="TableToggleButton_Click"
                        Header="OCR text as a table"
                        IsCheckable="True" />
                    <MenuItem
                        Name="FreezeMenuItem"
                        AutomationProperties.AutomationId="FullscreenGrab.Menu.Freeze"
                        Click="FreezeMenuItem_Click"
                        Header="Freeze"
                        IsCheckable="True"
                        IsChecked="True" />
                    <MenuItem Header="Selection Style">
                        <MenuItem
                            x:Name="RegionSelectionMenuItem"
                            AutomationProperties.AutomationId="FullscreenGrab.Menu.SelectionStyle.Region"
                            Click="SelectionStyleMenuItem_Click"
                            Header="Rectangle 1 - Drag a box"
                            InputGestureText="R"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Region" />
                        <MenuItem
                            x:Name="WindowSelectionMenuItem"
                            AutomationProperties.AutomationId="FullscreenGrab.Menu.SelectionStyle.Window"
                            Click="SelectionStyleMenuItem_Click"
                            Header="Window - Hover and click"
                            InputGestureText="W"
                            IsCheckable="True"
                            Tag="Window" />
                        <MenuItem
                            x:Name="FreeformSelectionMenuItem"
                            AutomationProperties.AutomationId="FullscreenGrab.Menu.SelectionStyle.Freeform"
                            Click="SelectionStyleMenuItem_Click"
                            Header="Freeform - Draw any shape"
                            InputGestureText="D"
                            IsCheckable="True"
                            Tag="Freeform" />
                        <MenuItem
                            x:Name="AdjustAfterSelectionMenuItem"
                            AutomationProperties.AutomationId="FullscreenGrab.Menu.SelectionStyle.AdjustAfter"
                            Click="SelectionStyleMenuItem_Click"
                            Header="Rectangle 2 - Drag, then adjust"
                            InputGestureText="A"
                            IsCheckable="True"
                            Tag="AdjustAfter" />
                    </MenuItem>
                    <Separator />
                    <MenuItem
                        Name="NewGrabFrameMenuItem"
                        AutomationProperties.AutomationId="FullscreenGrab.Menu.NewGrabFrame"
                        Click="NewGrabFrameMenuItem_Click"
                        Header="Place Grab Frame"
                        IsCheckable="True" />
                    <MenuItem
                        Name="SendToEtwMenuItem"
                        AutomationProperties.AutomationId="FullscreenGrab.Menu.SendToEditText"
                        Click="SendToEditTextToggleButton_Click"
                        Header="Send to Edit Text Window"
                        IsCheckable="True" />
                    <MenuItem
                        Name="EditLastGrabMenuItem"
                        AutomationProperties.AutomationId="FullscreenGrab.Menu.EditLastGrab"
                        Click="EditLastGrab_Click"
                        Header="Edit Last Grab" />
                    <MenuItem
                        Name="SettingsMenuItem"
                        AutomationProperties.AutomationId="FullscreenGrab.Menu.OpenSettings"
                        Click="SettingsMenuItem_Click"
                        Header="Settings" />
                    <Separator />
                    <MenuItem
                        Name="CancelMenuItem"
                        AutomationProperties.AutomationId="FullscreenGrab.Menu.Cancel"
                        Click="CancelMenuItem_Click"
                        Header="Cancel" />
                </ContextMenu>
            </Canvas.ContextMenu>
        </Canvas>
        <Canvas x:Name="SelectionOutlineHost" AutomationProperties.AutomationId="FullscreenGrab.SelectionOutline" IsHitTestVisible="False" />
        <Canvas x:Name="TemplateOverlayHost" AutomationProperties.AutomationId="FullscreenGrab.TemplateOverlay" IsHitTestVisible="False" />
        <Canvas x:Name="FindOnScreenOverlayHost" AutomationProperties.AutomationId="FullscreenGrab.FindOverlay" />
        <Border
            x:Name="TopButtonsStackPanel"
            AutomationProperties.AutomationId="FullscreenGrab.Toolbar"
            Margin="12"
            Padding="8"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            d:Background="Gray"
            d:Visibility="Visible"
            Background="{DynamicResource ApplicationBackgroundBrush}"
            CornerRadius="8"
            MouseEnter="RegionClickCanvas_MouseEnter"
            MouseLeave="RegionClickCanvas_MouseLeave"
            Visibility="Collapsed">
            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="32"
                    Direction="-90"
                    Opacity="0.6"
                    RenderingBias="Performance" />
            </Border.Effect>
            <Grid
                Margin="2,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Top">
                <StackPanel x:Name="CaptureToolbarOptions" Orientation="Horizontal">
                <ComboBox
                    x:Name="SelectionStyleComboBox"
                    AutomationProperties.AutomationId="FullscreenGrab.SelectionStyle"
                    AutomationProperties.Name="Capture selection style"
                    Width="34"
                    Height="34"
                    Margin="0,0,4,0"
                    ItemContainerStyle="{StaticResource SelectionStyleComboBoxItemStyle}"
                    SelectionChanged="SelectionStyleComboBox_SelectionChanged"
                    Style="{StaticResource SelectionStyleComboBoxStyle}"
                    ToolTip="Choose how to define the capture area.">
                    <ComboBoxItem Tag="Region" ToolTip="Region select (R)">
                        <wpfui:SymbolIcon FontSize="22" Symbol="RectangleLandscape24" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Window" ToolTip="Window select (W)">
                        <wpfui:SymbolIcon FontSize="22" Symbol="WindowMultiple20" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="Freeform" ToolTip="Draw freeform shape (D)">
                        <wpfui:SymbolIcon FontSize="22" Symbol="DrawShape24" />
                    </ComboBoxItem>
                    <ComboBoxItem Tag="AdjustAfter" ToolTip="Adjust after (A)">
                        <wpfui:SymbolIcon FontSize="22" Symbol="SelectObject24" />
                    </ComboBoxItem>
                </ComboBox>
                <ComboBox
                    x:Name="LanguagesComboBox"
                    AutomationProperties.AutomationId="FullscreenGrab.Language"
                    AutomationProperties.Name="OCR language"
                    Height="34"
                    Margin="0"
                    Padding="8,0"
                    Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}"
                    PreviewMouseDown="LanguagesComboBox_PreviewMouseDown"
                    SelectionChanged="LanguagesComboBox_SelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                FontFamily="Segoe UI"
                                Style="{StaticResource SymbolTextStyle}"
                                Text="{Binding DisplayName}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button
                    x:Name="FindOnScreenLaunchButton"
                    AutomationProperties.AutomationId="FullscreenGrab.FindOnScreenLaunch"
                    AutomationProperties.Name="Find on screen"
                    Width="34"
                    Height="34"
                    Margin="4,0,2,0"
                    Click="FindOnScreenLaunchButton_Click"
                    Style="{StaticResource SymbolButton}"
                    ToolTip="(Ctrl+F) Find text on screen">
                    <wpfui:SymbolIcon Symbol="Search24" />
                </Button>
                <ToggleButton
                    x:Name="FreezeToggleButton"
                    AutomationProperties.AutomationId="FullscreenGrab.FreezeToggle"
                    AutomationProperties.Name="Freeze screen"
                    Width="34"
                    Height="34"
                    Margin="4,0,2,0"
                    Click="FreezeMenuItem_Click"
                    IsChecked="{Binding IsChecked,
                                        ElementName=FreezeMenuItem,
                                        Mode=TwoWay}"
                    Style="{StaticResource ToggleSymbolButton}"
                    ToolTip="(F) Freeze what is on screens">
                    <wpfui:SymbolIcon Symbol="Pause24" />
                </ToggleButton>
                <Border
                    x:Name="ModeButtonsBorder"
                    Margin="2,0"
                    BorderBrush="{StaticResource Teal}"
                    BorderThickness="2"
                    CornerRadius="5">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton
                            x:Name="StandardModeToggleButton"
                            AutomationProperties.AutomationId="FullscreenGrab.StandardModeToggle"
                            AutomationProperties.Name="Normal multi-line OCR mode"
                            Width="30"
                            Height="30"
                            Margin="0"
                            Click="StandardModeToggleButton_Click"
                            IsChecked="True"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="(N) Normal Multi-line OCR Mode">
                            <wpfui:SymbolIcon Symbol="TextAlignLeft24" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="SingleLineToggleButton"
                            AutomationProperties.AutomationId="FullscreenGrab.SingleLineToggle"
                            AutomationProperties.Name="Single-line OCR mode"
                            Width="30"
                            Height="30"
                            Margin="0"
                            d:IsChecked="True"
                            Click="SingleLineMenuItem_Click"
                            IsChecked="{Binding IsChecked,
                                                ElementName=SingleLineMenuItem,
                                                Mode=TwoWay}"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="(S) Make result a single line">
                            <wpfui:SymbolIcon Symbol="SubtractSquare24" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="TableToggleButton"
                            AutomationProperties.AutomationId="FullscreenGrab.TableToggle"
                            AutomationProperties.Name="Table OCR mode"
                            Width="30"
                            Height="30"
                            Margin="0"
                            d:IsChecked="True"
                            Click="TableToggleButton_Click"
                            IsChecked="{Binding IsChecked,
                                                ElementName=TableMenuItem,
                                                Mode=TwoWay}"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="(T) OCR text as a table">
                            <wpfui:SymbolIcon Symbol="Table24" />
                        </ToggleButton>
                        <ToggleButton
                            x:Name="NewGrabFrameToggleButton"
                            AutomationProperties.AutomationId="FullscreenGrab.NewGrabFrameToggle"
                            AutomationProperties.Name="Place Grab Frame"
                            Width="30"
                            Height="30"
                            Margin="0"
                            d:IsChecked="True"
                            Click="NewGrabFrameMenuItem_Click"
                            IsChecked="{Binding IsChecked,
                                                ElementName=NewGrabFrameMenuItem,
                                                Mode=TwoWay}"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="(G) Place a Grab Frame">
                            <wpfui:SymbolIcon Symbol="PanelBottom20" />
                        </ToggleButton>
                    </StackPanel>
                </Border>
                <wpfui:DropDownButton
                    x:Name="NextStepDropDownButton"
                    AutomationProperties.AutomationId="FullscreenGrab.NextStepMenu"
                    AutomationProperties.Name="Post-capture actions"
                    Height="34"
                    Margin="2,0"
                    IsDefault="True"
                    MouseEnter="NextStepDropDownButton_MouseEnter"
                    MouseLeave="NextStepDropDownButton_MouseLeave"
                    Style="{StaticResource SymbolDropDownButton}"
                    ToolTip="Actions to perform after grabbing text...">
                    <wpfui:DropDownButton.Icon>
                        <wpfui:SymbolIcon x:Name="NextStepSymbolIcon" Symbol="FlashFlow24" />
                    </wpfui:DropDownButton.Icon>
                    <wpfui:DropDownButton.Flyout>
                        <ContextMenu
                            MouseEnter="RegionClickCanvas_MouseEnter"
                            MouseLeave="RegionClickCanvas_MouseLeave"
                            PreviewKeyDown="FullscreenGrab_KeyDown">
                            <!--<MenuItem
                                Name="GuidFixMenuItem"
                                Click="PostActionMenuItem_Click"
                                Header="Fix GUIDs"
                                InputGestureText="CTRL + 1"
                                IsCheckable="True"
                                StaysOpenOnClick="False"
                                ToolTip="Corrects common errors with hex (0-F) when OCRing UUID/GUIDs" />
                            <MenuItem
                                Name="TrimEachLineMenuItem"
                                Click="PostActionMenuItem_Click"
                                Header="Trim each line"
                                InputGestureText="CTRL + 2"
                                IsCheckable="True"
                                StaysOpenOnClick="False"
                                ToolTip="Remove empty space characters from the beginning and end of each line" />
                            <MenuItem
                                Name="RemoveDuplicatesMenuItem"
                                Click="PostActionMenuItem_Click"
                                Header="Remove duplicate lines"
                                InputGestureText="CTRL + 3"
                                IsCheckable="True"
                                StaysOpenOnClick="False"
                                ToolTip="Remove duplicate lines, keeping the first instance" />
                            <MenuItem
                                Name="WebSearchPostCapture"
                                Click="PostActionMenuItem_Click"
                                Header="Web Search"
                                InputGestureText="CTRL + 4"
                                IsCheckable="True"
                                StaysOpenOnClick="False"
                                ToolTip="Search the web using the default web search engine" />
                            <MenuItem
                                Name="InsertPostCapture"
                                Click="PostActionMenuItem_Click"
                                Header="Try to insert text"
                                InputGestureText="CTRL + 5"
                                IsCheckable="True"
                                StaysOpenOnClick="False"
                                ToolTip="Try to insert the copied text into the current caret position" />
                            <MenuItem
                                Name="TranslatePostCapture"
                                Click="PostActionMenuItem_Click"
                                Header="Translate to system language"
                                InputGestureText="CTRL + 6"
                                IsCheckable="True"
                                StaysOpenOnClick="False"
                                ToolTip="Translate the grabbed text to your system language using Windows AI"
                                Visibility="Collapsed" />-->
                        </ContextMenu>
                    </wpfui:DropDownButton.Flyout>
                </wpfui:DropDownButton>
                <Button
                    x:Name="AcceptSelectionButton"
                    AutomationProperties.AutomationId="FullscreenGrab.AcceptSelectionButton"
                    Width="44"
                    Height="34"
                    Margin="2,0"
                    Click="AcceptSelectionButton_Click"
                    Content="OK"
                    ToolTip="(Enter) Accept selection"
                    Visibility="Collapsed" />
                <ToggleButton
                    x:Name="SendToEditTextToggleButton"
                    AutomationProperties.AutomationId="FullscreenGrab.SendToEditTextToggle"
                    AutomationProperties.Name="Send result to Edit Text Window"
                    Width="34"
                    Height="34"
                    Margin="2,0"
                    d:IsChecked="True"
                    Click="SendToEditTextToggleButton_Click"
                    IsChecked="{Binding IsChecked,
                                        ElementName=SendToEtwMenuItem,
                                        Mode=TwoWay}"
                    Style="{StaticResource ToggleSymbolButton}"
                    ToolTip="(E) Send to an Edit Text Window">
                    <wpfui:SymbolIcon Symbol="Window24" />
                </ToggleButton>
                <Button
                    x:Name="SettingsButton"
                    AutomationProperties.AutomationId="FullscreenGrab.SettingsButton"
                    AutomationProperties.Name="Settings"
                    Width="34"
                    Height="34"
                    Margin="2,0"
                    Click="SettingsMenuItem_Click"
                    Style="{StaticResource SymbolButton}"
                    ToolTip="Settings">
                    <wpfui:SymbolIcon Symbol="Settings24" />
                </Button>
                <Button
                    x:Name="CancelButton"
                    AutomationProperties.AutomationId="FullscreenGrab.CancelButton"
                    AutomationProperties.Name="Cancel capture"
                    Width="34"
                    Height="34"
                    Margin="2,0,0,0"
                    Click="CancelMenuItem_Click"
                    Style="{StaticResource SymbolButton}"
                    ToolTip="(Esc) Cancel">
                    <wpfui:SymbolIcon Symbol="Dismiss24" />
                </Button>
                </StackPanel>
                <StackPanel
                    x:Name="FindOnScreenToolbarOptions"
                    d:Visibility="Collapsed"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <Grid Width="280" Height="34">
                        <TextBox
                            x:Name="FindOnScreenTextBox"
                            AutomationProperties.AutomationId="FullscreenGrab.FindOnScreenSearch"
                            AutomationProperties.Name="Find text on screen"
                            Padding="28,0,6,0"
                            VerticalContentAlignment="Center"
                            Background="{DynamicResource ControlFillColorDefaultBrush}"
                            GotFocus="FindOnScreenTextBox_GotFocus"
                            LostFocus="FindOnScreenTextBox_LostFocus"
                            Style="{StaticResource TextBoxStyle1}"
                            TextChanged="FindOnScreenTextBox_TextChanged"
                            ToolTip="(Ctrl+F) Find text on screen" />
                        <wpfui:SymbolIcon
                            Margin="8,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            FontSize="16"
                            Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}"
                            IsHitTestVisible="False"
                            Symbol="Search24" />
                        <TextBlock
                            x:Name="FindOnScreenPlaceholder"
                            Margin="30,0,6,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}"
                            IsHitTestVisible="False"
                            Opacity="0.55"
                            Text="Find on screen" />
                    </Grid>
                    <TextBlock
                        x:Name="FindOnScreenStatusText"
                        MinWidth="88"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="FullscreenGrab.FindOnScreenStatus"
                        Foreground="{wpfui:ThemeResource TextFillColorPrimaryBrush}" />
                    <Button
                        x:Name="FindOnScreenEnterKeyButton"
                        Height="26"
                        Margin="8,0,0,0"
                        Padding="7,0,6,1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="FullscreenGrab.FindOnScreenEnterKey"
                        AutomationProperties.Name="Run Enter action"
                        Click="FindOnScreenEnterKeyButton_Click"
                        Style="{StaticResource FindOnScreenEnterKeyButtonStyle}"
                        ToolTip="(Enter) Run the selected action">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Text="Enter" />
                            <wpfui:SymbolIcon
                                Margin="4,1,0,0"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Symbol="ArrowEnterLeft24" />
                        </StackPanel>
                    </Button>
                    <ComboBox
                        x:Name="FindOnScreenEnterActionComboBox"
                        Width="190"
                        Height="34"
                        Margin="6,0,0,0"
                        Padding="10,0"
                        VerticalContentAlignment="Center"
                        AutomationProperties.AutomationId="FullscreenGrab.FindOnScreenEnterAction"
                        AutomationProperties.Name="Action when Enter is pressed"
                        SelectionChanged="FindOnScreenEnterActionComboBox_SelectionChanged"
                        ToolTip="Action when Enter is pressed">
                        <ComboBoxItem Content="Copy matches" Tag="CopyMatches" />
                        <ComboBoxItem Content="Copy matched lines" Tag="CopyMatchedLines" />
                        <ComboBoxItem Content="Click an instance" Tag="ClickInstance" />
                        <ComboBoxItem Content="Grab matches region" Tag="GrabRegion" />
                        <ComboBoxItem Content="Place Grab Frame" Tag="PlaceGrabFrame" />
                    </ComboBox>
                    <Button
                        x:Name="FindOnScreenCloseButton"
                        AutomationProperties.AutomationId="FullscreenGrab.FindOnScreenClose"
                        AutomationProperties.Name="Close find on screen"
                        Width="34"
                        Height="34"
                        Margin="6,0,0,0"
                        Click="FindOnScreenCloseButton_Click"
                        Style="{StaticResource SymbolButton}"
                        ToolTip="Close search and restore capture options">
                        <wpfui:SymbolIcon Symbol="Dismiss24" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>

<Window
    x:Class="Text_Grab.Views.GrabFrame"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Text_Grab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Text_Grab.Views"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="GrabFrameWindow"
    Title="Grab Frame"
    Width="800"
    Height="450"
    MinWidth="150"
    MinHeight="150"
    Activated="GrabFrameWindow_Activated"
    AllowDrop="True"
    AllowsTransparency="True"
    Background="Transparent"
    BorderBrush="{ui:ThemeResource ApplicationBackgroundBrush}"
    BorderThickness="1"
    Closed="Window_Closed"
    Closing="GrabFrameWindow_Closing"
    Deactivated="GrabFrameWindow_Deactivated"
    DragLeave="GrabFrameWindow_DragLeave"
    DragOver="GrabFrameWindow_DragOver"
    Drop="GrabFrameWindow_Drop"
    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    Initialized="GrabFrameWindow_Initialized"
    Loaded="GrabFrame_Loaded"
    LocationChanged="Window_LocationChanged"
    ResizeMode="CanResizeWithGrip"
    SizeChanged="Window_SizeChanged"
    Topmost="True"
    Unloaded="GrabFrame_Unloaded"
    WindowStartupLocation="CenterOwner"
    WindowStyle="None"
    mc:Ignorable="d">
    <Window.Resources>
        <BitmapImage x:Key="TextGrabIcon" UriSource="/Text-Grab;component/Images/TealSelect40.png" />
    </Window.Resources>

    <Window.CommandBindings>
        <CommandBinding
            CanExecute="CanPasteExecute"
            Command="{x:Static local:GrabFrame.PasteCommand}"
            Executed="PasteExecuted" />
        <CommandBinding
            CanExecute="CanUndoCommand"
            Command="{x:Static local:GrabFrame.UndoCommand}"
            Executed="UndoExecuted" />
        <CommandBinding
            CanExecute="CanRedoExecuted"
            Command="{x:Static local:GrabFrame.RedoCommand}"
            Executed="RedoExecuted" />
        <CommandBinding
            CanExecute="CanChangeWordBorderExecute"
            Command="{x:Static local:GrabFrame.DeleteWordsCommand}"
            Executed="DeleteWordBordersExecuted" />
        <CommandBinding
            CanExecute="CanExecuteMergeWordBorders"
            Command="{x:Static local:GrabFrame.MergeWordsCommand}"
            Executed="MergeWordBordersExecuted" />
        <CommandBinding
            CanExecute="CanExecuteGrab"
            Command="{x:Static local:GrabFrame.GrabCommand}"
            Executed="GrabExecuted" />
        <CommandBinding
            CanExecute="CanExecuteGrab"
            Command="{x:Static local:GrabFrame.GrabTrimCommand}"
            Executed="GrabTrimExecuted" />
    </Window.CommandBindings>

    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="32"
            CornerRadius="18,18,2,18"
            GlassFrameThickness="0"
            ResizeBorderThickness="8" />
    </WindowChrome.WindowChrome>
    <Border
        BorderBrush="{ui:ThemeResource ApplicationBackgroundBrush}"
        BorderThickness="2"
        ClipToBounds="True">
        <Grid ClipToBounds="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Grid.RowSpan="3"
                VerticalAlignment="Top"
                Background="{ui:ThemeResource ApplicationBackgroundBrush}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Menu
                    Height="32"
                    VerticalAlignment="Center"
                    ClipToBounds="True"
                    WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="File" SubmenuOpened="MenuItem_SubmenuOpened">
                        <MenuItem
                            x:Name="AutoOcrCheckBox"
                            Click="AutoOcrCheckBox_Click"
                            Header="Auto Start OCR"
                            IsCheckable="True"
                            IsChecked="True" />
                        <MenuItem
                            x:Name="AlwaysUpdateEtwCheckBox"
                            Header="Auto Update Content in Edit Text Window"
                            IsCheckable="True"
                            IsChecked="True" />
                        <MenuItem
                            x:Name="ReadBarcodesMenuItem"
                            Checked="ReadBarcodesMenuItem_Checked"
                            Header="Try to read barcodes and QR Codes"
                            IsCheckable="True"
                            Unchecked="ReadBarcodesMenuItem_Checked" />
                        <MenuItem Header="Word Grouping">
                            <MenuItem
                                x:Name="WordGroupingWordMenuItem"
                                Click="WordGroupingMenuItem_Click"
                                Header="Word"
                                IsCheckable="True"
                                Tag="Word" />
                            <MenuItem
                                x:Name="WordGroupingLineMenuItem"
                                Click="WordGroupingMenuItem_Click"
                                Header="Line"
                                IsCheckable="True"
                                Tag="Line" />
                            <MenuItem
                                x:Name="WordGroupingParagraphMenuItem"
                                Click="WordGroupingMenuItem_Click"
                                Header="Paragraph"
                                IsCheckable="True"
                                Tag="Paragraph" />
                            <MenuItem
                                x:Name="WordGroupingWindowMenuItem"
                                Click="WordGroupingMenuItem_Click"
                                Header="Window"
                                IsCheckable="True"
                                Tag="Window" />
                        </MenuItem>
                        <MenuItem
                            x:Name="IsTopmostMenuItem"
                            Header="Keep Grab Frame On Top"
                            IsCheckable="True"
                            IsChecked="{Binding Topmost,
                                                ElementName=GrabFrameWindow,
                                                Mode=TwoWay}" />
                        <Separator />
                        <MenuItem x:Name="TranslationMenuItem" Header="Translation to...">
                            <MenuItem
                                x:Name="EnableTranslationMenuItem"
                                Click="EnableTranslationMenuItem_Click"
                                Header="Enable Real-time Translation"
                                IsCheckable="True" />
                            <Separator />
                            <MenuItem Header="Target Language">
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="English"
                                    IsCheckable="True"
                                    Tag="English" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="Spanish"
                                    IsCheckable="True"
                                    Tag="Spanish" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="French"
                                    IsCheckable="True"
                                    Tag="French" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="German"
                                    IsCheckable="True"
                                    Tag="German" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="Italian"
                                    IsCheckable="True"
                                    Tag="Italian" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="Portuguese"
                                    IsCheckable="True"
                                    Tag="Portuguese" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="Russian"
                                    IsCheckable="True"
                                    Tag="Russian" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="Japanese"
                                    IsCheckable="True"
                                    Tag="Japanese" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="Chinese (Simplified)"
                                    IsCheckable="True"
                                    Tag="Chinese (Simplified)" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="Korean"
                                    IsCheckable="True"
                                    Tag="Korean" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="Arabic"
                                    IsCheckable="True"
                                    Tag="Arabic" />
                                <MenuItem
                                    Click="TranslationLanguageMenuItem_Click"
                                    Header="Hindi"
                                    IsCheckable="True"
                                    Tag="Hindi" />
                            </MenuItem>
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            Command="{x:Static local:GrabFrame.PasteCommand}"
                            Header="Paste Image"
                            InputGestureText="Ctrl + Shift + V" />
                        <MenuItem
                            Click="OpenImageMenuItem_Click"
                            Header="Open Image or PDF..."
                            InputGestureText="Ctrl + O" />
                        <MenuItem
                            Click="OpenGrabFrameFileMenuItem_Click"
                            Header="Open Grab Frame File..." />
                        <MenuItem
                            Click="SaveGrabFrameFileMenuItem_Click"
                            Header="Save Grab Frame File..."
                            InputGestureText="Ctrl + S" />
                        <MenuItem x:Name="OpenRecentGrabsMenuItem" Header="Recent Grabs" />
                        <Separator />
                        <MenuItem
                            Name="GrabMenuItem"
                            Command="{x:Static local:GrabFrame.GrabCommand}"
                            Header="_Grab"
                            InputGestureText="Ctrl + G" />
                        <MenuItem
                            Name="GrabTrimSingleMenuItem"
                            Command="{x:Static local:GrabFrame.GrabTrimCommand}"
                            Header="Grab text as Single Line"
                            InputGestureText="Ctrl + Shift + G" />
                        <Separator />
                        <MenuItem
                            Name="ManageGrabTemplatesMenuItem"
                            Click="ManageGrabTemplates_Click"
                            Header="Manage Grab _Templates..." />
                        <MenuItem
                            Name="SettingsMenuItem"
                            Click="SettingsBTN_Click"
                            Header="Text Grab Settings" />
                        <MenuItem
                            Name="CloseMenuItem"
                            Click="OnCloseButtonClick"
                            Header="Close"
                            InputGestureText="Alt + F4" />
                    </MenuItem>
                    <MenuItem Header="Edit">
                        <MenuItem
                            Name="RedoMenuItem"
                            Command="{x:Static local:GrabFrame.RedoCommand}"
                            Header="Redo"
                            InputGestureText="Ctrl + Y" />
                        <MenuItem
                            Name="UndoMenuItem"
                            Command="{x:Static local:GrabFrame.UndoCommand}"
                            Header="Undo"
                            InputGestureText="Ctrl + Z" />
                        <MenuItem
                            Name="SelectAllMenuItem"
                            Click="SelectAllWordBorders"
                            Header="Select All"
                            InputGestureText="Ctrl + A" />
                        <MenuItem
                            Name="AddEditOcrMenuItem"
                            Header="Add, move, or Resize lines"
                            InputGestureText="Hold Ctrl"
                            IsCheckable="True" />
                        <Separator />
                        <MenuItem Header="Edit Image">
                            <MenuItem
                                Name="InvertColorsMI"
                                Click="InvertColorsMI_Click"
                                Header="Invert Colors" />
                            <MenuItem
                                Name="AutoContrastMI"
                                Click="AutoContrastMI_Click"
                                Header="Increase Contrast (Sigmoid)" />
                            <MenuItem
                                Name="BrightenMI"
                                Click="BrightenMI_Click"
                                Header="Brighten" />
                            <MenuItem
                                Name="DarkenMI"
                                Click="DarkenMI_Click"
                                Header="Darken" />
                            <MenuItem
                                Name="GrayscaleMI"
                                Click="GrayscaleMI_Click"
                                Header="Grayscale" />
                        </MenuItem>
                        <MenuItem
                            Click="RefreshBTN_Click"
                            Header="Refresh Grab Frame OCR Results"
                            InputGestureText="(Ctrl + R)" />
                        <MenuItem
                            Checked="AspectRationMI_Checked"
                            Header="Maintain Aspect Ratio"
                            IsCheckable="True"
                            IsChecked="{Binding IsChecked,
                                                ElementName=AspectRationMI,
                                                Mode=TwoWay}"
                            Unchecked="AspectRationMI_Checked" />
                        <MenuItem
                            Click="FreezeToggleButton_Click"
                            Header="Freeze Image In Frame"
                            InputGestureText="F"
                            IsCheckable="True"
                            IsChecked="{Binding IsChecked,
                                                ElementName=FreezeToggleButton,
                                                Mode=TwoWay}" />
                        <MenuItem
                            Click="TableToggleButton_Click"
                            Header="Analyze as a Table"
                            InputGestureText="T"
                            IsCheckable="True"
                            IsChecked="{Binding IsChecked,
                                                ElementName=TableToggleButton,
                                                Mode=TwoWay}" />
                        <MenuItem x:Name="EditTableMenuItem" Header="Table">
                            <MenuItem
                                x:Name="AddTableRowMenuItem"
                                Click="AddTableRowMenuItem_Click"
                                Header="Add Row" />
                            <MenuItem
                                x:Name="AddTableColumnMenuItem"
                                Click="AddTableColumnMenuItem_Click"
                                Header="Add Column" />
                            <Separator />
                            <MenuItem
                                x:Name="CancelTablePlacementMenuItem"
                                Click="CancelTablePlacement_Click"
                                Header="Cancel Placement" />
                        </MenuItem>
                        <MenuItem
                            Click="EditToggleButton_Click"
                            Header="Allow recognized words to be edited"
                            IsCheckable="True"
                            IsChecked="{Binding IsChecked,
                                                ElementName=EditToggleButton,
                                                Mode=TwoWay}" />
                        <MenuItem
                            Click="EditTextBTN_Click"
                            Header="Send results to an Edit Text Window"
                            InputGestureText="E"
                            IsCheckable="True"
                            IsChecked="{Binding IsChecked,
                                                ElementName=EditTextToggleButton,
                                                Mode=TwoWay}" />
                        <Separator />
                        <MenuItem
                            x:Name="InvertSelectionMenuItem"
                            Click="InvertSelection"
                            Header="Invert Selection"
                            InputGestureText="Ctrl + I" />
                        <MenuItem
                            Command="{x:Static local:GrabFrame.MergeWordsCommand}"
                            Header="Merge Word Borders"
                            InputGestureText="Ctrl + M" />
                        <MenuItem
                            Command="{x:Static local:GrabFrame.DeleteWordsCommand}"
                            Header="_Delete selected words"
                            InputGestureText="Del" />
                        <Separator />
                    </MenuItem>
                    <MenuItem Header="View">
                        <ui:MenuItem
                            x:Name="NoScrollBehaviorMenuItem"
                            Click="ScrollBehaviorMenuItem_Click"
                            Header="Scroll does nothing"
                            IsCheckable="True"
                            Tag="None" />
                        <MenuItem
                            x:Name="ResizeScrollMenuItem"
                            Click="ScrollBehaviorMenuItem_Click"
                            Header="Scroll resizes Grab Frame"
                            IsCheckable="True"
                            Tag="Resize" />
                        <MenuItem
                            x:Name="ZoomScrollMenuItem"
                            Click="ScrollBehaviorMenuItem_Click"
                            Header="Scroll Zooms Grab Frame (preview)"
                            IsCheckable="True"
                            Tag="Zoom" />
                        <MenuItem
                            x:Name="ZoomWhenFrozenScrollMenuItem"
                            Click="ScrollBehaviorMenuItem_Click"
                            Header="Zoom when frozen"
                            IsCheckable="True"
                            Tag="ZoomWhenFrozen" />
                        <Separator />
                        <MenuItem
                            x:Name="ScaleUpMenuItem"
                            Click="ScaleUpMenuItem_Click"
                            Header="Scale Up" />
                        <MenuItem
                            x:Name="ScaleDownMenuItem"
                            Click="ScaleDownMenuItem_Click"
                            Header="Scale Down" />
                        <Separator />
                        <MenuItem
                            x:Name="ResetViewMenuItem"
                            Click="ResetViewMenuItem_Click"
                            Header="Reset View"
                            InputGestureText="Middle Click" />
                        <Separator />
                        <MenuItem
                            x:Name="ShowWordBordersMenuItem"
                            Click="ShowWordBordersMenuItem_Click"
                            Header="Show Word Borders"
                            IsCheckable="True"
                            IsChecked="True" />
                        <MenuItem Header="Overlay Opacity">
                            <MenuItem
                                x:Name="OverlayOpacityOffMenuItem"
                                Click="OverlayOpacityMenuItem_Click"
                                Header="Off"
                                IsCheckable="True"
                                Tag="0" />
                            <MenuItem
                                x:Name="OverlayOpacityLowMenuItem"
                                Click="OverlayOpacityMenuItem_Click"
                                Header="5%"
                                IsCheckable="True"
                                IsChecked="True"
                                Tag="0.05" />
                        </MenuItem>
                        <Separator />
                        <MenuItem
                            x:Name="CloseOnGrabMenuItem"
                            Click="CloseOnGrabMenuItem_Click"
                            Header="Close Frame on Grab"
                            IsCheckable="True" />
                    </MenuItem>
                    <MenuItem Header="_Help">
                        <MenuItem
                            x:Name="ContactMenuItem"
                            Click="ContactMenuItem_Click"
                            Header="_Contact The Developer..." />
                        <MenuItem
                            x:Name="RateAndReview"
                            Click="RateAndReview_Click"
                            Header="_Rate and Review..." />
                        <MenuItem
                            x:Name="FeedbackMenuItem"
                            Click="FeedbackMenuItem_Click"
                            Header="_Feedback..." />
                        <MenuItem
                            x:Name="AboutMenuItem"
                            Click="AboutMenuItem_Click"
                            Header="_About" />
                    </MenuItem>
                </Menu>
                <StackPanel
                    Grid.Column="0"
                    Grid.ColumnSpan="3"
                    HorizontalAlignment="Center"
                    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                    ClipToBounds="True"
                    Orientation="Horizontal">
                    <Image
                        x:Name="WindowIcon"
                        Width="20"
                        Height="20"
                        Margin="4,2,4,4"
                        Source="{StaticResource TextGrabIcon}"
                        Stretch="UniformToFill">
                        <Image.Style>
                            <Style TargetType="Image">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Image.Style>
                    </Image>
                    <TextBlock
                        Margin="4,-4,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="13"
                        Text="Grab Frame">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsActive, RelativeSource={RelativeSource AncestorType=Window}}" Value="False">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
                <ui:TitleBar
                    Grid.ColumnSpan="3"
                    Width="200"
                    Height="32"
                    Margin="2,2,2,0"
                    Padding="8,2"
                    HorizontalAlignment="Right"
                    Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                    WindowChrome.IsHitTestVisibleInChrome="True" />
                <StackPanel
                    Grid.Column="2"
                    Orientation="Horizontal"
                    Visibility="Collapsed">
                    <Button
                        x:Name="MinimizeButton"
                        Width="46"
                        Height="32"
                        Margin="0,-2,0,0"
                        Click="OnMinimizeButtonClick"
                        Style="{StaticResource TitleBarButtonStyle}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" />
                    </Button>
                    <Button
                        x:Name="RestoreButton"
                        Width="46"
                        Height="32"
                        Margin="0,-2,0,0"
                        Click="OnRestoreButtonClick"
                        Style="{StaticResource TitleBarButtonStyle}">
                        <TextBlock
                            x:Name="RestoreTextlock"
                            FontFamily="Segoe MDL2 Assets"
                            Text="" />
                    </Button>
                    <Button
                        x:Name="CloseButton"
                        Width="46"
                        Height="32"
                        Margin="0,-2,0,0"
                        Click="OnCloseButtonClick"
                        Style="{StaticResource TitleBarCloseButtonStyle}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="" />
                    </Button>

                </StackPanel>
            </Grid>
            <Border
                x:Name="RectanglesBorder"
                Grid.Row="1"
                ClipToBounds="True">
                <Border.Background>
                    <SolidColorBrush Opacity=".05" Color="White" />
                </Border.Background>
                <Grid>
                    <controls:ZoomBorder x:Name="MainZoomBorder">
                        <Viewbox Name="CanvasViewBox">
                            <Grid>
                                <Image
                                    x:Name="GrabFrameImage"
                                    Grid.Row="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Opacity="0"
                                    Stretch="Uniform" />
                                <Canvas
                                    x:Name="PdfTextCanvas"
                                    Margin="0"
                                    ClipToBounds="True"
                                    ContextMenu="{Binding ContextMenu,
                                                          ElementName=RectanglesCanvas}"
                                    MouseDown="RectanglesCanvas_MouseDown"
                                    MouseMove="RectanglesCanvas_MouseMove"
                                    MouseUp="RectanglesCanvas_MouseUp" />
                                <Canvas
                                    x:Name="RectanglesCanvas"
                                    Margin="0"
                                    Background="Transparent"
                                    Focusable="True"
                                    IsHitTestVisible="True"
                                    MouseDown="RectanglesCanvas_MouseDown"
                                    MouseMove="RectanglesCanvas_MouseMove"
                                    MouseUp="RectanglesCanvas_MouseUp">
                                    <Canvas.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Command="{x:Static local:GrabFrame.PasteCommand}"
                                                Header="Paste Image"
                                                InputGestureText="Ctrl + Shift + V" />
                                            <MenuItem
                                                Click="OpenImageMenuItem_Click"
                                                Header="Open Image or PDF..."
                                                InputGestureText="Ctrl + O" />
                                            <Separator />
                                            <MenuItem
                                                x:Name="CopyText"
                                                Click="CopyText_Click"
                                                Header="Copy Text" />
                                            <Separator />
                                            <MenuItem
                                                x:Name="AspectRationMI"
                                                Checked="AspectRationMI_Checked"
                                                Header="Maintain Aspect Ratio"
                                                IsCheckable="True"
                                                IsChecked="True"
                                                Unchecked="AspectRationMI_Checked" />
                                            <MenuItem
                                                x:Name="FreezeMI"
                                                Click="FreezeMI_Click"
                                                Header="Toggle Freeze"
                                                InputGestureText="F" />
                                            <Separator />
                                            <MenuItem
                                                x:Name="TryToNumberMenuItem"
                                                Click="TryToNumberMenuItem_Click"
                                                Header="Try To Make _Numbers" />
                                            <MenuItem
                                                x:Name="TryToAlphaMenuItem"
                                                Click="TryToAlphaMenuItem_Click"
                                                Header="Try To Make _Letters" />
                                            <MenuItem
                                                Command="{x:Static local:GrabFrame.MergeWordsCommand}"
                                                Header="Merge Word Borders"
                                                InputGestureText="Ctrl + M" />
                                            <MenuItem
                                                Command="{x:Static local:GrabFrame.DeleteWordsCommand}"
                                                Header="_Delete selected words"
                                                InputGestureText="Del" />
                                        </ContextMenu>
                                    </Canvas.ContextMenu>
                                </Canvas>
                                <Canvas
                                    x:Name="TemplateRegionOverlayCanvas"
                                    Margin="-4,-2,0,0"
                                    Panel.ZIndex="5"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False" />
                                <Canvas
                                    x:Name="TablePlacementOverlayCanvas"
                                    Margin="0"
                                    Panel.ZIndex="6"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False" />
                            </Grid>
                        </Viewbox>
                    </controls:ZoomBorder>
                    <Border
                        x:Name="TablePlacementBanner"
                        Margin="16"
                        Padding="12,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.35"
                                ShadowDepth="3"
                                Color="Black" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                x:Name="TablePlacementInstructionsTextBlock"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Text="Click to place a table divider." />
                            <Button
                                x:Name="CancelTablePlacementButton"
                                MinWidth="72"
                                Click="CancelTablePlacement_Click"
                                Content="Cancel" />
                        </StackPanel>
                    </Border>
                    <Border
                        x:Name="TranslationProgressBorder"
                        Height="40"
                        Margin="8"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Direction="270"
                                Opacity="0.3"
                                ShadowDepth="2"
                                Color="Black" />
                        </Border.Effect>
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                Symbol="LocalLanguage24" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    x:Name="TranslationProgressText"
                                    Margin="0,0,0,2"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="Translating..." />
                                <ProgressBar
                                    x:Name="TranslationProgressBar"
                                    Height="6"
                                    Maximum="100"
                                    Minimum="0"
                                    Value="0" />
                            </StackPanel>
                            <TextBlock
                                x:Name="TranslationCountText"
                                Grid.Column="2"
                                Margin="12,0,8,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                Text="0/0" />
                            <Button
                                x:Name="CancelTranslationButton"
                                Grid.Column="3"
                                Width="28"
                                Height="28"
                                Padding="0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="CancelTranslationButton_Click"
                                ToolTip="Cancel translation">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    Symbol="Dismiss24" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border
                        x:Name="SpeakingProgressBorder"
                        Height="40"
                        Margin="8"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="8"
                                Direction="270"
                                Opacity="0.3"
                                ShadowDepth="2"
                                Color="Black" />
                        </Border.Effect>
                        <Grid Margin="8,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon
                                Grid.Column="0"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{ui:ThemeResource AccentTextFillColorPrimaryBrush}"
                                Symbol="Speaker224" />
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Vertical">
                                <TextBlock
                                    Margin="0,0,0,2"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                                    Text="Speaking..." />
                                <ProgressBar
                                    Height="6"
                                    IsIndeterminate="True" />
                            </StackPanel>
                            <Button
                                x:Name="StopSpeakingButton"
                                Grid.Column="2"
                                Width="28"
                                Height="28"
                                Padding="0"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="StopSpeakingButton_Click"
                                ToolTip="Stop speaking">
                                <ui:SymbolIcon
                                    FontSize="16"
                                    Foreground="{ui:ThemeResource TextFillColorSecondaryBrush}"
                                    Symbol="Stop24" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border
                        x:Name="FrameMessageBorder"
                        MaxWidth="420"
                        Margin="16,16,16,20"
                        Padding="12,8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                        BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="12"
                                Direction="270"
                                Opacity="0.35"
                                ShadowDepth="3"
                                Color="Black" />
                        </Border.Effect>
                        <TextBlock
                            x:Name="FrameMessageTextBlock"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>
                </Grid>
            </Border>
            <!--  Template Save Panel (collapsed by default, shown when Save as Template is toggled)  -->
            <Border
                x:Name="TemplateSavePanel"
                Grid.Row="2"
                Background="{ui:ThemeResource ApplicationBackgroundBrush}"
                BorderBrush="{ui:ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Visibility="Collapsed">
                <Grid Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="160" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Text="Template Name:" />
                    <TextBox
                        x:Name="TemplateNameBox"
                        Grid.Column="1"
                        Padding="4,2"
                        VerticalContentAlignment="Center" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="8,0,6,0"
                        VerticalAlignment="Center"
                        Text="Output (type { to pick):"
                        ToolTip="Type { to insert a region chip. Plain text is also supported." />
                    <controls:InlinePickerRichTextBox
                        x:Name="TemplateOutputBox"
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        AcceptsReturn="True"
                        AcceptsTab="True"
                        TextChanged="TemplateOutputBox_TextChanged"
                        ToolTip="Type { to open the region picker. Plain text also supported." />
                    <Button
                        Grid.Column="4"
                        Margin="8,0,4,0"
                        Padding="8,4"
                        Click="SaveTemplateSave_Click"
                        Content="Save Template" />
                    <Button
                        Grid.Column="5"
                        Padding="8,4"
                        Click="SaveTemplateCancel_Click"
                        Content="Cancel" />
                </Grid>
            </Border>

            <Border Grid.Row="3" Background="{ui:ThemeResource ApplicationBackgroundBrush}">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Show Toolbar Buttons" IsEnabled="False" />
                        <Separator />
                        <MenuItem
                            x:Name="ShowRefreshToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="Re-OCR / OCR Frame"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Refresh" />
                        <MenuItem
                            x:Name="ShowFreezeToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="Freeze"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Freeze" />
                        <MenuItem
                            x:Name="ShowTableToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="Analyze as Table"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Table" />
                        <MenuItem
                            x:Name="ShowTranslateToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="Translate"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Translate" />
                        <MenuItem
                            x:Name="ShowSpeakToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="Speak"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Speak" />
                        <MenuItem
                            x:Name="ShowEditTextToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="Edit Text Window"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="EditText" />
                        <MenuItem
                            x:Name="ShowTemplateToolMenuItem"
                            Click="ToggleBottomBarToolMenuItem_Click"
                            Header="Grab Template"
                            IsCheckable="True"
                            IsChecked="True"
                            Tag="Template" />
                    </ContextMenu>
                </Border.ContextMenu>
                <Grid
                    MinHeight="36"
                    Margin="6"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Bottom">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>

                    <controls:SearchBar
                        x:Name="SearchBar"
                        Grid.Column="1"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        PlaceholderText="Search For Text..."
                        SearchChanged="SearchBar_SearchChanged"
                        ShowExactMatchToggle="True" />

                    <Menu
                        x:Name="MatchesMenu"
                        Grid.Column="2"
                        Height="28"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        d:Visibility="Visible"
                        ClipToBounds="True"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        Visibility="Collapsed">
                        <MenuItem>
                            <MenuItem.Header>
                                <TextBlock
                                    x:Name="MatchesTXTBLK"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Text="Matches: 0" />
                            </MenuItem.Header>
                            <MenuItem Click="HandleDelete" Header="Delete Selected" />
                            <Separator />
                            <MenuItem
                                Name="EditMatchesMenuItem"
                                Click="EditMatchesMenuItem_Click"
                                Header="Edit Selected in new Window" />
                        </MenuItem>
                    </Menu>

                    <ComboBox
                        x:Name="LanguagesComboBox"
                        Grid.Column="3"
                        MinWidth="60"
                        Padding="8,0"
                        Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
                        PreviewMouseDown="LanguagesComboBox_MouseDown"
                        SelectionChanged="LanguagesComboBox_SelectionChanged">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe UI"
                                    Style="{StaticResource SymbolTextStyle}"
                                    Text="{Binding LanguageTag}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <StackPanel
                        x:Name="ButtonsStackPanel"
                        Grid.Column="4"
                        Margin="6,0"
                        Orientation="Horizontal">
                        <StackPanel
                            x:Name="PdfPagePanel"
                            Margin="0,0,6,0"
                            Orientation="Horizontal"
                            Visibility="Collapsed">
                            <Button
                                x:Name="PreviousPdfPageButton"
                                Width="30"
                                Height="30"
                                Padding="0"
                                Click="PreviousPdfPageButton_Click"
                                ToolTip="Previous PDF page">
                                <ui:SymbolIcon Symbol="ChevronLeft24" />
                            </Button>
                            <TextBlock
                                x:Name="PdfPageTextBlock"
                                Margin="6,0"
                                VerticalAlignment="Center"
                                Text="Page 1 / 1" />
                            <Button
                                x:Name="NextPdfPageButton"
                                Width="30"
                                Height="30"
                                Margin="6,0,0,0"
                                Padding="0"
                                Click="NextPdfPageButton_Click"
                                ToolTip="Next PDF page">
                                <ui:SymbolIcon Symbol="ChevronRight24" />
                            </Button>
                        </StackPanel>
                        <controls:CollapsibleButton
                            x:Name="RefreshBTN"
                            Width="30"
                            Height="30"
                            Margin="0"
                            ButtonSymbol="ArrowClockwise24"
                            ButtonText="Re-OCR Frame"
                            Click="RefreshBTN_Click"
                            IsSymbol="True"
                            ToolTip="Re-OCR Frame (Ctrl + R)" />
                        <controls:CollapsibleButton
                            x:Name="OcrFrameBTN"
                            Margin="0"
                            ButtonSymbol="ScanText24"
                            ButtonText="OCR Frame"
                            Click="RefreshBTN_Click"
                            ToolTip="OCR Frame (Ctrl + R)"
                            Visibility="Collapsed" />

                        <ToggleButton
                            x:Name="FreezeToggleButton"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            Click="FreezeToggleButton_Click"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="(F) Freeze the content within Grab Frame">
                            <ui:SymbolIcon Symbol="Pause24" />
                        </ToggleButton>

                        <ToggleButton
                            x:Name="TableToggleButton"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            Click="TableToggleButton_Click"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="(T) Analyze content as tables">
                            <ToggleButton.ContextMenu>
                                <ContextMenu>
                                    <MenuItem
                                        x:Name="TableToggleAddRowMenuItem"
                                        Click="AddTableRowMenuItem_Click"
                                        Header="Add Row" />
                                    <MenuItem
                                        x:Name="TableToggleAddColumnMenuItem"
                                        Click="AddTableColumnMenuItem_Click"
                                        Header="Add Column" />
                                    <Separator />
                                    <MenuItem
                                        x:Name="TableToggleCancelPlacementMenuItem"
                                        Click="CancelTablePlacement_Click"
                                        Header="Cancel Placement" />
                                </ContextMenu>
                            </ToggleButton.ContextMenu>
                            <ui:SymbolIcon Symbol="Table24" />
                        </ToggleButton>

                        <ToggleButton
                            x:Name="TranslateToggleButton"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            Click="TranslateToggleButton_Click"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="Enable real-time translation">
                            <ui:SymbolIcon Symbol="LocalLanguage24" />
                        </ToggleButton>

                        <ToggleButton
                            x:Name="SpeakToggleButton"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            Click="SpeakToggleButton_Click"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="Speak grabbed text aloud">
                            <ui:SymbolIcon Symbol="Speaker224" />
                        </ToggleButton>

                        <ToggleButton
                            x:Name="EditToggleButton"
                            Margin="6,0,0,0"
                            Padding="7,4"
                            Click="EditToggleButton_Click"
                            IsChecked="True"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="Edit individual words in Grab Frame"
                            Visibility="Collapsed">
                            <TextBlock FontFamily="Segoe MDL2 Assets">
                                
                            </TextBlock>
                        </ToggleButton>

                        <ToggleButton
                            x:Name="EditTextToggleButton"
                            Width="30"
                            Height="30"
                            Margin="6,0,0,0"
                            d:IsChecked="True"
                            Click="EditTextBTN_Click"
                            IsChecked="False"
                            Style="{StaticResource ToggleSymbolButton}"
                            ToolTip="(E) Edit individual words in Grab Frame">
                            <ui:SymbolIcon Symbol="Window24" />
                        </ToggleButton>

                        <controls:CollapsibleButton
                            x:Name="SettingsBTN"
                            Margin="6,0,0,0"
                            ButtonSymbol="Settings24"
                            ButtonText="Settings"
                            Click="SettingsBTN_Click"
                            IsSymbol="True"
                            ToolTip="Open Text Grab Settings"
                            Visibility="Collapsed" />

                        <ui:DropDownButton
                            x:Name="TemplateMenuButton"
                            Width="50"
                            Height="30"
                            Margin="6,0,0,0"
                            Padding="0"
                            ToolTip="Select or create a Grab Template">
                            <ui:DropDownButton.Content>
                                <ui:SymbolIcon Symbol="DocumentSave24" />
                            </ui:DropDownButton.Content>
                            <ui:DropDownButton.Flyout>
                                <ContextMenu x:Name="TemplateContextMenu" Opened="TemplateContextMenu_Opened" />
                            </ui:DropDownButton.Flyout>
                        </ui:DropDownButton>
                    </StackPanel>

                    <controls:CollapsibleButton
                        x:Name="GrabBTN"
                        Grid.Column="5"
                        Width="110"
                        Margin="0"
                        ButtonSymbol="Copy24"
                        ButtonText="Grab"
                        Command="{x:Static local:GrabFrame.GrabCommand}"
                        ToolTip="Grab text in the Grab Frame" />
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>

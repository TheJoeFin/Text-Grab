                AutomationProperties.AutomationId="EditText.ProgressText"
                Margin="0,12,0,0"
                FontSize="16"
                FontWeight="Bold"
                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                Text="Working..." />
        </StackPanel>
        <!--  Non-blocking, cancellable status shown while transcribing audio; text streams into the editor beneath it.  -->
        <Border
            x:Name="TranscriptionStatusBar"
            Grid.Row="2"
            Grid.ColumnSpan="2"
            Margin="0,10,0,0"
            Padding="12,6"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Panel.ZIndex="500"
            Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="16"
            Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ProgressRing
                    Width="18"
                    Height="18"
                    IsIndeterminate="True" />
                <TextBlock
                    x:Name="TranscriptionStatusText"
                    Margin="10,0,12,0"
                    VerticalAlignment="Center"
                    Text="Transcribing…" />
                <Button
                    x:Name="TranscriptionCancelButton"
                    Padding="10,2"
                    Click="TranscriptionCancelButton_Click"
                    Content="Cancel" />
            </StackPanel>
        </Border>
        <ui:ContentDialogHost
            x:Name="PendingFileCloseDialogHost"
            AutomationProperties.AutomationId="EditText.PendingFileCloseDialog"
            Grid.RowSpan="4"
            Panel.ZIndex="999"
            IsDisableSiblingsEnabled="True" />
    </Grid>
</ui:FluentWindow>

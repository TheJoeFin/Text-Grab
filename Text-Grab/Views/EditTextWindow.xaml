                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                            <Run Text="• Variables: x = 10" />
                        </TextBlock>
                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                            <Run Text="• Constants: pi, e, tau, phi, sqrt2, sqrt3, sqrt5, ln2, ln10, log2e, log10e" />
                        </TextBlock>
                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                            <Run Text="• Unit conversion: 5 miles to km, 100°F to celsius" />
                        </TextBlock>
                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                            <Run Text="• Date math: today + 5 days, 5-14-26 - 1-12-25 in weeks" />
                        </TextBlock>
                        <TextBlock Margin="0,0,0,4" TextWrapping="Wrap">
                            <Run Text="• Supported units: length, mass, temperature, volume, speed, area, durations" />
                        </TextBlock>
                        <TextBlock
                            Margin="0,0,0,4"
                            FontWeight="SemiBold"
                            Text="Examples:" />
                        <TextBlock
                            Margin="0,0,0,4"
                            FontFamily="Consolas"
                            FontSize="12"
                            TextWrapping="Wrap">
                            <Run Text="x = 10" /><LineBreak />
                            <Run Text="y = 20" /><LineBreak />
                            <Run Text="x + y" /><LineBreak />
                            <Run Text="sin(pi/2)" /><LineBreak />
                            <Run Text="sqrt(x * y)" />

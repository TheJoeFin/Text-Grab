{
  "schemaVersion": "1.0",
  "id": "markdown-preview",
  "name": "Markdown preview",
  "root": {
    "type": "split",
    "orientation": "horizontal",
    "children": [
      {
        "node": { "type": "pane", "paneId": "textgrab.pane.editor" },
        "size": 1,
        "unit": "star"
      },
      {
        "node": { "type": "pane", "paneId": "textgrab.pane.markdownPreview" },
        "size": 1,
        "unit": "star"
      }
    ]
  },
  "defaultMode": "code",
  "defaultCodeLanguage": "MarkDown"
}
